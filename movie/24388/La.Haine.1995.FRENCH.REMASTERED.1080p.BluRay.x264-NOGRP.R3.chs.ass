Dialogue: 0,0:00:02.00,0:00:15.00,Default,,0,0,0,,中字：源自R3DVD\N调轴：微博@吸片的猫
Dialogue: 0,0:00:26.20,0:00:28.77,Default,,0,0,0,,凶手们，快开枪！
Dialogue: 0,0:00:28.77,0:00:31.53,Default,,0,0,0,,我们没有枪，只有命一条
Dialogue: 0,0:00:31.57,0:00:35.45,Default,,0,0,0,,“恨”
Dialogue: 0,0:00:46.58,0:00:51.24,Default,,0,0,0,,本片献给制造过程中的牺牲者
Dialogue: 0,0:00:53.51,0:01:00.35,Default,,0,0,0,,这是某人从50楼坠下的故事
Dialogue: 0,0:01:00.35,0:01:02.21,Default,,0,0,0,,坠落时他重复地安慰自己
Dialogue: 0,0:01:03.44,0:01:04.67,Default,,0,0,0,,目前为止还好
Dialogue: 0,0:01:05.98,0:01:07.30,Default,,0,0,0,,目前为止还好
Dialogue: 0,0:01:08.72,0:01:10.19,Default,,0,0,0,,目前为止还好
Dialogue: 0,0:01:12.65,0:01:14.63,Default,,0,0,0,,然而坠落过程并不重要
Dialogue: 0,0:01:16.40,0:01:18.06,Default,,0,0,0,,而是落地的剎那
Dialogue: 0,0:04:51.13,0:04:54.88,Default,,0,0,0,,昨晚慕格市发生暴动
Dialogue: 0,0:04:54.88,0:04:59.53,Default,,0,0,0,,午夜时，约有百名年轻人
Dialogue: 0,0:04:59.53,0:05:02.00,Default,,0,0,0,,围攻市区内的警局
Dialogue: 0,0:05:02.00,0:05:04.78,Default,,0,0,0,,暴乱中有14名警察受伤
Dialogue: 0,0:05:04.78,0:05:07.21,Default,,0,0,0,,警方逮捕33名嫌犯
Dialogue: 0,0:05:07.21,0:05:10.03,Default,,0,0,0,,暴民砸毁部份商业中心及民房
Dialogue: 0,0:05:10.03,0:05:13.05,Default,,0,0,0,,暴动至凌晨4点结束
Dialogue: 0,0:05:13.05,0:05:16.80,Default,,0,0,0,,事件起因于一名警官在2天前
Dialogue: 0,0:05:16.80,0:05:20.62,Default,,0,0,0,,将拘留的年轻人打成重伤
Dialogue: 0,0:05:20.62,0:05:23.40,Default,,0,0,0,,警官遭到停职处分
Dialogue: 0,0:05:23.40,0:05:24.93,Default,,0,0,0,,但是阿布德一直在加护病房
Dialogue: 0,0:05:24.93,0:05:27.36,Default,,0,0,0,,医生认为他情况严重…
Dialogue: 0,0:05:27.36,0:05:28.83,Default,,0,0,0,,为了侦讯一名未成年窃犯…
Dialogue: 0,0:06:37.22,0:06:41.74,Default,,0,0,0,,“扎伊尔干警察”
Dialogue: 0,0:06:46.81,0:06:48.40,Default,,0,0,0,,文兹！
Dialogue: 0,0:06:48.79,0:06:50.78,Default,,0,0,0,,那家伙在搞什么？
Dialogue: 0,0:06:51.12,0:06:51.92,Default,,0,0,0,,干嘛？
Dialogue: 0,0:06:51.92,0:06:54.75,Default,,0,0,0,,什么“干嘛”？不会跟我问好吗？
Dialogue: 0,0:06:55.18,0:06:57.58,Default,,0,0,0,,少烦我，你要干嘛！
Dialogue: 0,0:06:57.58,0:06:58.95,Default,,0,0,0,,去叫你哥下来
Dialogue: 0,0:06:59.29,0:07:00.33,Default,,0,0,0,,为什么？
Dialogue: 0,0:07:00.33,0:07:01.39,Default,,0,0,0,,叫他下来
Dialogue: 0,0:07:01.83,0:07:02.45,Default,,0,0,0,,为什么？
Dialogue: 0,0:07:02.45,0:07:03.71,Default,,0,0,0,,去叫他下来
Dialogue: 0,0:07:04.12,0:07:05.28,Default,,0,0,0,,为什么？
Dialogue: 0,0:07:06.14,0:07:08.19,Default,,0,0,0,,你在演相声吗？
Dialogue: 0,0:07:08.19,0:07:10.14,Default,,0,0,0,,你们别再鬼吼鬼叫
Dialogue: 0,0:07:10.14,0:07:13.77,Default,,0,0,0,,昨晚还没有叫够吗
Dialogue: 0,0:07:14.39,0:07:16.55,Default,,0,0,0,,你昨晚有看到我吗
Dialogue: 0,0:07:16.55,0:07:18.08,Default,,0,0,0,,少来这套
Dialogue: 0,0:07:18.08,0:07:22.38,Default,,0,0,0,,学娘们唠唠叨叨，白痴
Dialogue: 0,0:07:23.75,0:07:26.11,Default,,0,0,0,,下次暴动我要烧了你
Dialogue: 0,0:07:26.11,0:07:29.91,Default,,0,0,0,,你睡死啦？快去叫他
Dialogue: 0,0:07:29.91,0:07:30.39,Default,,0,0,0,,王八，你要叫谁？
Dialogue: 0,0:07:30.39,0:07:31.65,Default,,0,0,0,,你还不快点去
Dialogue: 0,0:07:31.65,0:07:33.21,Default,,0,0,0,,我不敢，他睡死了，要去你去
Dialogue: 0,0:07:33.21,0:07:35.55,Default,,0,0,0,,我希望警察把你关起来
Dialogue: 0,0:07:51.48,0:07:52.38,Default,,0,0,0,,文兹！
Dialogue: 0,0:07:54.86,0:07:56.28,Default,,0,0,0,,把那臭嘴拿开
Dialogue: 0,0:07:56.28,0:07:59.59,Default,,0,0,0,,妈的，你这样跟我讲话？
Dialogue: 0,0:07:59.59,0:08:00.74,Default,,0,0,0,,客气点，不然要你死
Dialogue: 0,0:08:00.74,0:08:02.50,Default,,0,0,0,,滚远点，你有口臭
Dialogue: 0,0:08:02.89,0:08:04.52,Default,,0,0,0,,一早就想干架？
Dialogue: 0,0:08:05.16,0:08:07.59,Default,,0,0,0,,好！1，2，3
Dialogue: 0,0:08:09.26,0:08:10.42,Default,,0,0,0,,你输了
Dialogue: 0,0:08:10.93,0:08:12.06,Default,,0,0,0,,我操你姐
Dialogue: 0,0:08:12.46,0:08:14.86,Default,,0,0,0,,干嘛扯到我姐？我提过她吗？
Dialogue: 0,0:08:15.32,0:08:17.75,Default,,0,0,0,,别提你的变态姊姊，滚
Dialogue: 0,0:08:17.75,0:08:21.09,Default,,0,0,0,,死犹太人，来跟我一决胜负
Dialogue: 0,0:08:22.10,0:08:23.60,Default,,0,0,0,,我看到母牛
Dialogue: 0,0:08:23.60,0:08:24.40,Default,,0,0,0,,你看到啥？
Dialogue: 0,0:08:24.40,0:08:25.37,Default,,0,0,0,,母牛
Dialogue: 0,0:08:25.37,0:08:26.40,Default,,0,0,0,,大麻放哪？
Dialogue: 0,0:08:26.80,0:08:27.70,Default,,0,0,0,,盒子里
Dialogue: 0,0:08:31.18,0:08:33.78,Default,,0,0,0,,昨晚暴动时，我拼命跑
Dialogue: 0,0:08:34.25,0:08:37.70,Default,,0,0,0,,一个转弯后，撞上母牛
Dialogue: 0,0:08:38.42,0:08:42.65,Default,,0,0,0,,别抽了，对你很不好
Dialogue: 0,0:08:43.19,0:08:45.42,Default,,0,0,0,,下床！不然告诉外婆你在吸毒
Dialogue: 0,0:08:45.42,0:08:47.96,Default,,0,0,0,,去讲啊，我会割你喉咙
Dialogue: 0,0:08:47.96,0:08:50.53,Default,,0,0,0,,把你倒挂吊起来，被血噎死
Dialogue: 0,0:08:50.53,0:08:53.19,Default,,0,0,0,,外婆！外婆！
Dialogue: 0,0:08:54.25,0:08:56.10,Default,,0,0,0,,下去啦
Dialogue: 0,0:08:56.10,0:08:57.66,Default,,0,0,0,,不准你再到我的床上
Dialogue: 0,0:08:57.66,0:09:01.21,Default,,0,0,0,,“外婆”！小间谍滚
Dialogue: 0,0:09:01.21,0:09:02.74,Default,,0,0,0,,下去啦
Dialogue: 0,0:09:03.20,0:09:06.17,Default,,0,0,0,,别这样对我妹讲话
Dialogue: 0,0:09:06.71,0:09:08.91,Default,,0,0,0,,没盐巴
Dialogue: 0,0:09:09.11,0:09:10.78,Default,,0,0,0,,你怎么跟外婆解释？
Dialogue: 0,0:09:10.78,0:09:12.14,Default,,0,0,0,,你是我爸？
Dialogue: 0,0:09:12.14,0:09:13.53,Default,,0,0,0,,干嘛提到爸爸
Dialogue: 0,0:09:13.53,0:09:15.17,Default,,0,0,0,,你是我妈？
Dialogue: 0,0:09:15.17,0:09:16.63,Default,,0,0,0,,你为什么没去上学
Dialogue: 0,0:09:16.63,0:09:17.98,Default,,0,0,0,,学校被烧了
Dialogue: 0,0:09:17.98,0:09:20.52,Default,,0,0,0,,学校被烧？真野蛮
Dialogue: 0,0:09:20.52,0:09:23.10,Default,,0,0,0,,再下去，连教堂也被烧
Dialogue: 0,0:09:23.10,0:09:25.81,Default,,0,0,0,,外婆…
Dialogue: 0,0:09:25.81,0:09:26.72,Default,,0,0,0,,什么事？
Dialogue: 0,0:09:26.72,0:09:28.21,Default,,0,0,0,,我没有烧学校
Dialogue: 0,0:09:28.21,0:09:30.89,Default,,0,0,0,,你也没去教堂啊
Dialogue: 0,0:09:30.89,0:09:33.26,Default,,0,0,0,,你烦死我了
Dialogue: 0,0:09:33.26,0:09:35.87,Default,,0,0,0,,如果每次谈话，大家就逃
Dialogue: 0,0:09:35.87,0:09:38.03,Default,,0,0,0,,这个家会垮
Dialogue: 0,0:09:38.03,0:09:40.71,Default,,0,0,0,,至少大家逃的方向一致
Dialogue: 0,0:09:40.71,0:09:42.79,Default,,0,0,0,,败家子
Dialogue: 0,0:09:42.79,0:09:44.09,Default,,0,0,0,,你在跟我说话吗
Dialogue: 0,0:09:44.50,0:09:45.90,Default,,0,0,0,,你在跟我说话吗
Dialogue: 0,0:09:54.14,0:09:55.91,Default,,0,0,0,,混蛋，你在跟我说话吗
Dialogue: 0,0:09:55.91,0:09:57.71,Default,,0,0,0,,喂，你是跟我说话吗
Dialogue: 0,0:09:59.98,0:10:01.68,Default,,0,0,0,,小子，你是跟我说话吗
Dialogue: 0,0:10:02.28,0:10:04.44,Default,,0,0,0,,干，你这样跟我说话？
Dialogue: 0,0:10:16.65,0:10:19.36,Default,,0,0,0,,他说“我会为了钱做任何事”
Dialogue: 0,0:10:19.36,0:10:20.83,Default,,0,0,0,,“连杀人也敢”
Dialogue: 0,0:10:20.83,0:10:23.76,Default,,0,0,0,,他对朋友说“我会为了钱杀你”
Dialogue: 0,0:10:24.24,0:10:26.23,Default,,0,0,0,,朋友一脸愕然
Dialogue: 0,0:10:26.64,0:10:29.13,Default,,0,0,0,,你知道他怎么回答？
Dialogue: 0,0:10:29.63,0:10:32.10,Default,,0,0,0,,“开玩笑的，你是我的好友”
Dialogue: 0,0:10:32.10,0:10:34.81,Default,,0,0,0,,“我会免费杀你”
Dialogue: 0,0:10:34.81,0:10:36.14,Default,,0,0,0,,这句很酷吧
Dialogue: 0,0:10:36.14,0:10:37.93,Default,,0,0,0,,那家伙说“我会免费杀你”
Dialogue: 0,0:10:38.36,0:10:39.76,Default,,0,0,0,,文兹，这句正典吧
Dialogue: 0,0:10:39.76,0:10:41.67,Default,,0,0,0,,我听一次就懂了
Dialogue: 0,0:10:41.67,0:10:43.79,Default,,0,0,0,,喂，叫你哥来找我
Dialogue: 0,0:10:43.79,0:10:47.79,Default,,0,0,0,,“我会免费杀你”这句够酷吧
Dialogue: 0,0:10:47.79,0:10:51.60,Default,,0,0,0,,别再说了，大麻给我
Dialogue: 0,0:10:52.88,0:10:55.17,Default,,0,0,0,,这句话够屌吧
Dialogue: 0,0:10:55.17,0:10:56.15,Default,,0,0,0,,够屌
Dialogue: 0,0:10:56.15,0:10:59.52,Default,,0,0,0,,“我会免费杀你”真是登峰造极
Dialogue: 0,0:10:59.52,0:11:00.85,Default,,0,0,0,,你想不出更好的
Dialogue: 0,0:11:03.59,0:11:05.82,Default,,0,0,0,,你今天是怎么了？便秘啊？
Dialogue: 0,0:11:10.48,0:11:12.28,Default,,0,0,0,,我干
Dialogue: 0,0:11:15.42,0:11:18.55,Default,,0,0,0,,那群杂种把这里全毁了
Dialogue: 0,0:11:22.00,0:11:23.36,Default,,0,0,0,,我的天
Dialogue: 0,0:11:28.54,0:11:30.60,Default,,0,0,0,,不敢相信
Dialogue: 0,0:11:32.30,0:11:34.36,Default,,0,0,0,,文兹，他们怎能开车进来？
Dialogue: 0,0:11:34.80,0:11:37.50,Default,,0,0,0,,门又不够大
Dialogue: 0,0:11:39.33,0:11:41.39,Default,,0,0,0,,扎伊尔，不太妙
Dialogue: 0,0:11:42.15,0:11:44.86,Default,,0,0,0,,他好像有点激动
Dialogue: 0,0:11:44.86,0:11:48.16,Default,,0,0,0,,还用说，为了拳击馆他辛苦2年
Dialogue: 0,0:12:04.21,0:12:06.33,Default,,0,0,0,,文兹，你的大麻真棒
Dialogue: 0,0:12:07.58,0:12:09.57,Default,,0,0,0,,不是我的，是雨贝的
Dialogue: 0,0:12:14.85,0:12:17.43,Default,,0,0,0,,扎伊尔，别抽到睡着
Dialogue: 0,0:12:17.43,0:12:18.89,Default,,0,0,0,,我以为你戒掉了
Dialogue: 0,0:12:18.89,0:12:20.32,Default,,0,0,0,,我也这么以为
Dialogue: 0,0:12:22.44,0:12:24.24,Default,,0,0,0,,这里出了什么事？
Dialogue: 0,0:12:24.60,0:12:25.50,Default,,0,0,0,,你想呢
Dialogue: 0,0:12:26.09,0:12:27.32,Default,,0,0,0,,被烧过？
Dialogue: 0,0:12:28.81,0:12:31.52,Default,,0,0,0,,恭喜你登上天才宝座
Dialogue: 0,0:12:31.52,0:12:33.19,Default,,0,0,0,,你真可笑
Dialogue: 0,0:12:33.19,0:12:35.98,Default,,0,0,0,,我早知道会有这种下场
Dialogue: 0,0:12:35.98,0:12:38.07,Default,,0,0,0,,那你干嘛死命留住它
Dialogue: 0,0:12:38.48,0:12:40.88,Default,,0,0,0,,白痴，因为他觉得值得
Dialogue: 0,0:12:40.88,0:12:43.44,Default,,0,0,0,,你很机车！你晓得是谁干的？
Dialogue: 0,0:12:43.91,0:12:45.64,Default,,0,0,0,,我根本懒得知道
Dialogue: 0,0:12:47.67,0:12:50.35,Default,,0,0,0,,雨贝，他们怎能开车进来？
Dialogue: 0,0:12:50.35,0:12:52.14,Default,,0,0,0,,门又不够大
Dialogue: 0,0:12:54.80,0:12:55.67,Default,,0,0,0,,文兹！
Dialogue: 0,0:13:00.44,0:13:03.95,Default,,0,0,0,,一群王八死条子
Dialogue: 0,0:13:03.95,0:13:07.33,Default,,0,0,0,,刚开始连动都不动
Dialogue: 0,0:13:07.33,0:13:10.36,Default,,0,0,0,,突然，这些王八蛋开始镇压
Dialogue: 0,0:13:10.36,0:13:12.05,Default,,0,0,0,,这群混蛋用十字镐镇压平民
Dialogue: 0,0:13:16.72,0:13:20.83,Default,,0,0,0,,结果小尚被打得很惨
Dialogue: 0,0:13:20.83,0:13:24.69,Default,,0,0,0,,三下就把他打烂
Dialogue: 0,0:13:24.69,0:13:29.99,Default,,0,0,0,,真是你他妈的轻松
Dialogue: 0,0:13:31.34,0:13:32.39,Default,,0,0,0,,你听
Dialogue: 0,0:13:41.95,0:13:43.11,Default,,0,0,0,,山叶机车
Dialogue: 0,0:13:43.69,0:13:45.85,Default,,0,0,0,,山你妈的大头机车
Dialogue: 0,0:13:46.23,0:13:48.25,Default,,0,0,0,,是默罕的川崎机车
Dialogue: 0,0:13:48.25,0:13:49.26,Default,,0,0,0,,他刚换消音器
Dialogue: 0,0:13:49.26,0:13:51.69,Default,,0,0,0,,不，是文兹的妈骑三轮车
Dialogue: 0,0:13:51.69,0:13:53.78,Default,,0,0,0,,哪个默罕？
Dialogue: 0,0:13:53.78,0:13:56.01,Default,,0,0,0,,法莉达的弟弟？
Dialogue: 0,0:13:56.01,0:13:57.91,Default,,0,0,0,,法莉达？刚拿到驾照的那个？
Dialogue: 0,0:13:58.34,0:14:02.72,Default,,0,0,0,,不，在市场工作的法莉达
Dialogue: 0,0:14:02.72,0:14:05.86,Default,,0,0,0,,昨晚你们应该参加的
Dialogue: 0,0:14:05.86,0:14:08.32,Default,,0,0,0,,感觉好强烈
Dialogue: 0,0:14:09.09,0:14:12.54,Default,,0,0,0,,在牢里待二天被整得死去活来
Dialogue: 0,0:14:12.54,0:14:14.76,Default,,0,0,0,,回家还被爸妈臭骂
Dialogue: 0,0:14:14.76,0:14:17.51,Default,,0,0,0,,老实说，我看不出有啥了不起
Dialogue: 0,0:14:17.51,0:14:19.64,Default,,0,0,0,,胡说八道
Dialogue: 0,0:14:20.82,0:14:24.82,Default,,0,0,0,,暴动是对付条子的最佳办法
Dialogue: 0,0:14:24.82,0:14:27.39,Default,,0,0,0,,我认为赚钱更重要
Dialogue: 0,0:14:27.39,0:14:29.52,Default,,0,0,0,,这些蠢暴动会毁了你们
Dialogue: 0,0:14:29.52,0:14:32.51,Default,,0,0,0,,有兄弟被打，我就会挺身而出
Dialogue: 0,0:14:33.24,0:14:36.55,Default,,0,0,0,,哪里有兄弟？我认识吗？
Dialogue: 0,0:14:36.55,0:14:40.18,Default,,0,0,0,,我不会为了人渣挨打
Dialogue: 0,0:14:41.17,0:14:43.23,Default,,0,0,0,,走了？
Dialogue: 0,0:14:51.27,0:14:52.93,Default,,0,0,0,,我是说真的
Dialogue: 0,0:14:53.49,0:14:55.65,Default,,0,0,0,,阿布德不是人渣
Dialogue: 0,0:14:55.65,0:14:57.84,Default,,0,0,0,,我只知道我跑不赢子弹
Dialogue: 0,0:15:04.11,0:15:06.37,Default,,0,0,0,,你们干嘛？别碰香肠
Dialogue: 0,0:15:06.37,0:15:07.90,Default,,0,0,0,,给我们香肠
Dialogue: 0,0:15:07.90,0:15:09.50,Default,,0,0,0,,是你付钱？
Dialogue: 0,0:15:09.50,0:15:13.22,Default,,0,0,0,,少来，你会弄哭我们
Dialogue: 0,0:15:13.22,0:15:17.99,Default,,0,0,0,,扎伊尔别闹，不然你真的会哭
Dialogue: 0,0:15:17.99,0:15:21.26,Default,,0,0,0,,妈的，一条5元
Dialogue: 0,0:15:21.26,0:15:25.46,Default,,0,0,0,,雨贝不用，因为他住这里
Dialogue: 0,0:15:26.17,0:15:28.16,Default,,0,0,0,,一条要5块？
Dialogue: 0,0:15:28.78,0:15:32.78,Default,,0,0,0,,对，是一条，不是两条
Dialogue: 0,0:15:32.78,0:15:35.01,Default,,0,0,0,,妈的，真好吃
Dialogue: 0,0:15:36.36,0:15:38.39,Default,,0,0,0,,我只有5块
Dialogue: 0,0:15:40.15,0:15:43.39,Default,,0,0,0,,好！给我记住
Dialogue: 0,0:15:43.39,0:15:45.90,Default,,0,0,0,,千万别忘
Dialogue: 0,0:15:45.90,0:15:48.73,Default,,0,0,0,,少整我，让我赊账
Dialogue: 0,0:15:49.38,0:15:51.64,Default,,0,0,0,,操你姐，我干嘛让你赊账
Dialogue: 0,0:15:51.64,0:15:54.30,Default,,0,0,0,,干嘛骂我姐？
Dialogue: 0,0:15:56.26,0:15:57.86,Default,,0,0,0,,少在这里装清纯
Dialogue: 0,0:15:58.49,0:16:00.61,Default,,0,0,0,,扎伊尔，香肠还来
Dialogue: 0,0:16:00.61,0:16:02.53,Default,,0,0,0,,借我二元买香肠？
Dialogue: 0,0:16:02.53,0:16:04.02,Default,,0,0,0,,我们一毛钱都没有
Dialogue: 0,0:16:04.02,0:16:05.62,Default,,0,0,0,,一毛也没有
Dialogue: 0,0:16:05.62,0:16:08.48,Default,,0,0,0,,法官说，选择缓刑二个月关二年
Dialogue: 0,0:16:08.48,0:16:10.15,Default,,0,0,0,,或是市政府劳动
Dialogue: 0,0:16:10.15,0:16:12.44,Default,,0,0,0,,那可是狗屎工作
Dialogue: 0,0:16:12.44,0:16:15.61,Default,,0,0,0,,你做过？我两种都不要
Dialogue: 0,0:16:15.61,0:16:17.84,Default,,0,0,0,,干！我已经钉过橱子
Dialogue: 0,0:16:17.84,0:16:20.03,Default,,0,0,0,,你钉橱子干嘛？
Dialogue: 0,0:16:20.03,0:16:22.71,Default,,0,0,0,,你弟弟偷了一条香肠
Dialogue: 0,0:16:22.71,0:16:23.89,Default,,0,0,0,,你说谎
Dialogue: 0,0:16:23.89,0:16:25.28,Default,,0,0,0,,看他的嘴巴
Dialogue: 0,0:16:25.28,0:16:26.96,Default,,0,0,0,,记在我的帐上
Dialogue: 0,0:16:26.96,0:16:28.51,Default,,0,0,0,,说谎，你的鼻子变长了
Dialogue: 0,0:16:38.96,0:16:41.59,Default,,0,0,0,,扎伊尔，你的鼻子会烂掉
Dialogue: 0,0:16:44.74,0:16:46.96,Default,,0,0,0,,一把自动45手枪
Dialogue: 0,0:16:46.96,0:16:50.02,Default,,0,0,0,,跟“致命武器”里一样
Dialogue: 0,0:16:50.02,0:16:52.57,Default,,0,0,0,,片子我看过，应该是M92
Dialogue: 0,0:16:52.57,0:16:57.54,Default,,0,0,0,,不对，应该是“沙漠老鹰”
Dialogue: 0,0:16:57.54,0:16:59.77,Default,,0,0,0,,你根本不懂
Dialogue: 0,0:16:59.77,0:17:01.68,Default,,0,0,0,,当他在路上朝卡车开枪…
Dialogue: 0,0:17:01.68,0:17:03.60,Default,,0,0,0,,这不是“致命武器”
Dialogue: 0,0:17:03.60,0:17:04.99,Default,,0,0,0,,你们在说什么？
Dialogue: 0,0:17:04.99,0:17:07.01,Default,,0,0,0,,你们在说什么？
Dialogue: 0,0:17:08.92,0:17:12.09,Default,,0,0,0,,听说昨晚警察遗失警枪
Dialogue: 0,0:17:12.09,0:17:13.93,Default,,0,0,0,,你不晓得？
Dialogue: 0,0:17:13.93,0:17:15.39,Default,,0,0,0,,这里有警枪？
Dialogue: 0,0:17:15.39,0:17:18.07,Default,,0,0,0,,我不知道是谁丢了武器
Dialogue: 0,0:17:18.07,0:17:21.13,Default,,0,0,0,,但是我想知道是谁捡到它
Dialogue: 0,0:17:27.88,0:17:32.03,Default,,0,0,0,,我不想在牢里长大
Dialogue: 0,0:17:32.03,0:17:34.15,Default,,0,0,0,,反正劳动一下又不会死
Dialogue: 0,0:17:34.60,0:17:37.70,Default,,0,0,0,,因扒窃而劳动1个月值得吗
Dialogue: 0,0:17:37.70,0:17:39.54,Default,,0,0,0,,你不觉得，可是我觉得
Dialogue: 0,0:17:39.54,0:17:42.78,Default,,0,0,0,,你胡扯什么？我从没劳动过
Dialogue: 0,0:17:42.78,0:17:44.20,Default,,0,0,0,,因为你从没被抓
Dialogue: 0,0:17:44.20,0:17:45.90,Default,,0,0,0,,不，是我不干了
Dialogue: 0,0:17:47.27,0:17:48.55,Default,,0,0,0,,来看谁来看我们了
Dialogue: 0,0:17:48.55,0:17:49.98,Default,,0,0,0,,快来看
Dialogue: 0,0:17:49.98,0:17:52.90,Default,,0,0,0,,快来看
Dialogue: 0,0:17:52.90,0:17:54.93,Default,,0,0,0,,是市长
Dialogue: 0,0:17:55.86,0:17:58.66,Default,,0,0,0,,王八市长！干
Dialogue: 0,0:18:00.04,0:18:03.55,Default,,0,0,0,,关掉音乐，冷静一点
Dialogue: 0,0:18:03.55,0:18:07.28,Default,,0,0,0,,诺丁，你是这里的老大？
Dialogue: 0,0:18:08.28,0:18:11.27,Default,,0,0,0,,你们以为这里是游乐园吗
Dialogue: 0,0:18:11.27,0:18:15.58,Default,,0,0,0,,你们无权到屋顶，快下去
Dialogue: 0,0:18:16.25,0:18:18.06,Default,,0,0,0,,我们又没做坏事
Dialogue: 0,0:18:18.06,0:18:21.82,Default,,0,0,0,,跟那无关，下去就对了
Dialogue: 0,0:18:21.82,0:18:26.59,Default,,0,0,0,,我们在这里很舒服
Dialogue: 0,0:18:27.21,0:18:30.69,Default,,0,0,0,,快下去
Dialogue: 0,0:18:30.69,0:18:33.13,Default,,0,0,0,,你在学校只学过这句话？
Dialogue: 0,0:18:33.13,0:18:35.25,Default,,0,0,0,,不要闹了
Dialogue: 0,0:18:35.25,0:18:38.38,Default,,0,0,0,,安静！
Dialogue: 0,0:18:38.38,0:18:39.67,Default,,0,0,0,,再吵就不客气了
Dialogue: 0,0:18:39.67,0:18:41.06,Default,,0,0,0,,总之你们不能在这里
Dialogue: 0,0:18:41.06,0:18:43.64,Default,,0,0,0,,把东西收拾干净
Dialogue: 0,0:18:43.64,0:18:49.13,Default,,0,0,0,,大家面带笑容下楼去
Dialogue: 0,0:18:49.72,0:18:51.01,Default,,0,0,0,,好
Dialogue: 0,0:18:51.01,0:18:53.62,Default,,0,0,0,,你要怎样把我们弄下去？
Dialogue: 0,0:18:53.62,0:18:56.68,Default,,0,0,0,,骑着你的走狗们下去吗
Dialogue: 0,0:18:57.73,0:19:00.06,Default,,0,0,0,,我们只是尽守本分
Dialogue: 0,0:19:00.65,0:19:03.26,Default,,0,0,0,,让我们留在这里
Dialogue: 0,0:19:03.26,0:19:05.20,Default,,0,0,0,,闭嘴！
Dialogue: 0,0:19:06.50,0:19:10.19,Default,,0,0,0,,少这样讲话，我又不认识你
Dialogue: 0,0:19:10.19,0:19:11.30,Default,,0,0,0,,你们可以走了
Dialogue: 0,0:19:11.30,0:19:13.86,Default,,0,0,0,,杂种们滚！
Dialogue: 0,0:19:16.38,0:19:18.50,Default,,0,0,0,,大家别闹了
Dialogue: 0,0:19:18.50,0:19:21.91,Default,,0,0,0,,想留下的留下，想走的就走
Dialogue: 0,0:19:21.91,0:19:24.28,Default,,0,0,0,,我留下
Dialogue: 0,0:19:24.28,0:19:26.23,Default,,0,0,0,,你下去，下去
Dialogue: 0,0:19:26.23,0:19:27.20,Default,,0,0,0,,让我留下
Dialogue: 0,0:19:27.20,0:19:28.24,Default,,0,0,0,,我说什么？
Dialogue: 0,0:19:28.24,0:19:29.60,Default,,0,0,0,,我下去
Dialogue: 0,0:19:29.60,0:19:30.51,Default,,0,0,0,,你要做什么？
Dialogue: 0,0:19:30.51,0:19:32.84,Default,,0,0,0,,我要下去
Dialogue: 0,0:19:32.84,0:19:38.37,Default,,0,0,0,,我要下去！
Dialogue: 0,0:19:38.37,0:19:40.32,Default,,0,0,0,,文兹，过来
Dialogue: 0,0:19:40.32,0:19:42.22,Default,,0,0,0,,我们得下去
Dialogue: 0,0:19:42.62,0:19:43.56,Default,,0,0,0,,你们在干嘛
Dialogue: 0,0:19:43.56,0:19:45.02,Default,,0,0,0,,妈的，你真没胆
Dialogue: 0,0:19:45.02,0:19:49.65,Default,,0,0,0,,他叫我下去就得下去
Dialogue: 0,0:20:05.09,0:20:07.11,Default,,0,0,0,,就像在性商店里般兴奋
Dialogue: 0,0:20:07.11,0:20:08.36,Default,,0,0,0,,那玩意叫啥？
Dialogue: 0,0:20:08.36,0:20:09.55,Default,,0,0,0,,丁字裤
Dialogue: 0,0:20:09.55,0:20:10.28,Default,,0,0,0,,什么？
Dialogue: 0,0:20:10.28,0:20:11.88,Default,,0,0,0,,笨！丁字裤
Dialogue: 0,0:20:11.88,0:20:15.01,Default,,0,0,0,,我用力地操那个妞
Dialogue: 0,0:20:15.01,0:20:21.62,Default,,0,0,0,,结果好恐怖…笑什么？
Dialogue: 0,0:20:21.62,0:20:25.07,Default,,0,0,0,,结果她一直要个不停
Dialogue: 0,0:20:25.07,0:20:27.71,Default,,0,0,0,,隔壁的家伙敲门叫我们别吵
Dialogue: 0,0:20:27.71,0:20:29.48,Default,,0,0,0,,你根本是做梦
Dialogue: 0,0:20:30.43,0:20:33.04,Default,,0,0,0,,我做梦？
Dialogue: 0,0:20:33.04,0:20:34.11,Default,,0,0,0,,你认识那个妞？
Dialogue: 0,0:20:34.11,0:20:36.13,Default,,0,0,0,,对，她有爱滋
Dialogue: 0,0:20:36.13,0:20:38.23,Default,,0,0,0,,什么？别胡说
Dialogue: 0,0:20:38.78,0:20:40.97,Default,,0,0,0,,各位好，这是电视采访
Dialogue: 0,0:20:40.97,0:20:43.79,Default,,0,0,0,,昨晚你们有参与暴动吗
Dialogue: 0,0:20:43.79,0:20:45.11,Default,,0,0,0,,你们有烧毁车子吗
Dialogue: 0,0:20:45.11,0:20:47.24,Default,,0,0,0,,你认为我们像小混混吗
Dialogue: 0,0:20:47.65,0:20:48.83,Default,,0,0,0,,我没这个意思
Dialogue: 0,0:20:48.83,0:20:50.89,Default,,0,0,0,,你认为我们像什么？
Dialogue: 0,0:20:50.89,0:20:51.65,Default,,0,0,0,,没什么
Dialogue: 0,0:20:51.65,0:20:54.23,Default,,0,0,0,,这里不是拓里，为什么不下车
Dialogue: 0,0:20:54.23,0:20:55.76,Default,,0,0,0,,我们还有工作…
Dialogue: 0,0:20:55.76,0:20:56.91,Default,,0,0,0,,你忙什么？
Dialogue: 0,0:20:56.91,0:21:00.94,Default,,0,0,0,,到处扒粪搞独家新闻？
Dialogue: 0,0:21:00.94,0:21:02.79,Default,,0,0,0,,别拍了
Dialogue: 0,0:21:02.79,0:21:04.56,Default,,0,0,0,,你以为你是谁？
Dialogue: 0,0:21:04.56,0:21:08.67,Default,,0,0,0,,竟敢跑来我的地盘撒野？快滚
Dialogue: 0,0:21:08.67,0:21:10.06,Default,,0,0,0,,你还拍个屁？
Dialogue: 0,0:21:10.06,0:21:13.89,Default,,0,0,0,,臭婊子，胆敢来骚扰我们
Dialogue: 0,0:21:13.89,0:21:16.08,Default,,0,0,0,,这里不是拓里！
Dialogue: 0,0:21:16.08,0:21:20.48,Default,,0,0,0,,妈的，今天老是碰到畜牲
Dialogue: 0,0:21:22.31,0:21:24.19,Default,,0,0,0,,这个欠干的女人是谁？
Dialogue: 0,0:21:24.19,0:21:26.52,Default,,0,0,0,,什么是拓里？
Dialogue: 0,0:21:27.35,0:21:29.68,Default,,0,0,0,,是动物园
Dialogue: 0,0:21:30.62,0:21:32.64,Default,,0,0,0,,什么鬼拓里
Dialogue: 0,0:21:32.64,0:21:34.56,Default,,0,0,0,,开门！
Dialogue: 0,0:21:34.56,0:21:36.26,Default,,0,0,0,,我不“仍”
Dialogue: 0,0:21:36.26,0:21:37.55,Default,,0,0,0,,国语标准一点
Dialogue: 0,0:21:37.55,0:21:39.95,Default,,0,0,0,,我还要睡
Dialogue: 0,0:21:39.95,0:21:42.80,Default,,0,0,0,,都已经下午了
Dialogue: 0,0:21:42.80,0:21:45.06,Default,,0,0,0,,你们别闹
Dialogue: 0,0:21:45.06,0:21:47.99,Default,,0,0,0,,你头上戴什么鬼，好像发芽
Dialogue: 0,0:21:47.99,0:21:49.87,Default,,0,0,0,,你们别找碴
Dialogue: 0,0:21:49.87,0:21:53.83,Default,,0,0,0,,你戴帽子要拍戏吗
Dialogue: 0,0:21:53.83,0:21:55.92,Default,,0,0,0,,这是什么烂电视？
Dialogue: 0,0:21:55.92,0:21:57.42,Default,,0,0,0,,小心点！
Dialogue: 0,0:21:57.42,0:22:00.44,Default,,0,0,0,,只是件运动服
Dialogue: 0,0:22:00.44,0:22:04.34,Default,,0,0,0,,这是你偷的新电视？什么烂货
Dialogue: 0,0:22:04.34,0:22:06.36,Default,,0,0,0,,它太大了，不好搬
Dialogue: 0,0:22:06.36,0:22:09.09,Default,,0,0,0,,我昨晚去拿钱，你怎么不在？
Dialogue: 0,0:22:10.36,0:22:13.32,Default,,0,0,0,,你的钱不在我这里
Dialogue: 0,0:22:13.32,0:22:15.72,Default,,0,0,0,,你不晓得出了什么事？
Dialogue: 0,0:22:15.72,0:22:19.13,Default,,0,0,0,,看看你的朋友们干了些什么
Dialogue: 0,0:22:19.13,0:22:22.85,Default,,0,0,0,,是弗埃的弟弟做的
Dialogue: 0,0:22:22.85,0:22:26.82,Default,,0,0,0,,所以呢？
Dialogue: 0,0:22:26.82,0:22:28.56,Default,,0,0,0,,还用问！给我他的地址
Dialogue: 0,0:22:28.56,0:22:30.02,Default,,0,0,0,,你看他们把我的车弄成这样
Dialogue: 0,0:22:30.02,0:22:31.24,Default,,0,0,0,,你们看看
Dialogue: 0,0:22:31.24,0:22:32.94,Default,,0,0,0,,别乱碰
Dialogue: 0,0:22:32.94,0:22:34.86,Default,,0,0,0,,5万块泡汤了
Dialogue: 0,0:22:34.86,0:22:36.84,Default,,0,0,0,,我要怎么上班？
Dialogue: 0,0:22:36.84,0:22:38.89,Default,,0,0,0,,你说什么？
Dialogue: 0,0:22:38.89,0:22:41.40,Default,,0,0,0,,你真没良心
Dialogue: 0,0:22:41.40,0:22:43.52,Default,,0,0,0,,它是我仅有的财产
Dialogue: 0,0:22:43.52,0:22:44.43,Default,,0,0,0,,闭嘴
Dialogue: 0,0:22:44.43,0:22:45.75,Default,,0,0,0,,别碰
Dialogue: 0,0:22:45.75,0:22:50.34,Default,,0,0,0,,我们兄弟住院你却只在乎车子
Dialogue: 0,0:22:50.34,0:22:52.71,Default,,0,0,0,,谁跟你兄弟，它才是我兄弟
Dialogue: 0,0:22:52.71,0:22:53.72,Default,,0,0,0,,你真恶心
Dialogue: 0,0:22:53.72,0:22:56.22,Default,,0,0,0,,这5万块是我全部的生命
Dialogue: 0,0:22:56.22,0:22:58.17,Default,,0,0,0,,是暴动新闻
Dialogue: 0,0:22:58.17,0:23:00.15,Default,,0,0,0,,我只在乎我的车子
Dialogue: 0,0:23:00.15,0:23:03.22,Default,,0,0,0,,什么烂电视
Dialogue: 0,0:23:03.22,0:23:10.84,Default,,0,0,0,,砸烂它
Dialogue: 0,0:23:10.84,0:23:12.68,Default,,0,0,0,,调整天线
Dialogue: 0,0:23:12.68,0:23:20.93,Default,,0,0,0,,我尽量，好了
Dialogue: 0,0:23:20.93,0:23:22.77,Default,,0,0,0,,是戴维耶
Dialogue: 0,0:23:22.77,0:23:25.14,Default,,0,0,0,,妈的，为什么拍到他？
Dialogue: 0,0:23:25.14,0:23:28.41,Default,,0,0,0,,干！我就在旁边，居然没拍我
Dialogue: 0,0:23:28.41,0:23:30.88,Default,,0,0,0,,闭嘴，快调天线
Dialogue: 0,0:23:30.88,0:23:32.93,Default,,0,0,0,,这种烂货我有啥办法
Dialogue: 0,0:23:32.93,0:23:35.09,Default,,0,0,0,,这个王八为何被拍到？
Dialogue: 0,0:23:35.09,0:23:36.76,Default,,0,0,0,,我的钱在哪
Dialogue: 0,0:23:36.76,0:23:39.48,Default,,0,0,0,,我没拿，在亚斯戴那里
Dialogue: 0,0:23:39.48,0:23:42.43,Default,,0,0,0,,起来，外套给我，滚开
Dialogue: 0,0:23:42.43,0:23:44.69,Default,,0,0,0,,有个警察丢了枪
Dialogue: 0,0:23:44.69,0:23:47.56,Default,,0,0,0,,你们应该很高兴吧
Dialogue: 0,0:23:49.70,0:23:53.12,Default,,0,0,0,,我希望捡到的人把巴黎烧毁
Dialogue: 0,0:23:53.12,0:23:55.13,Default,,0,0,0,,改变一下现状
Dialogue: 0,0:23:55.13,0:23:57.19,Default,,0,0,0,,你讲这种话真令我惊讶
Dialogue: 0,0:23:57.19,0:24:00.18,Default,,0,0,0,,你们中风啦，还不快走
Dialogue: 0,0:24:01.22,0:24:04.74,Default,,0,0,0,,你看过整人节目吧
Dialogue: 0,0:24:04.74,0:24:08.88,Default,,0,0,0,,有位名人心知他会被整
Dialogue: 0,0:24:08.88,0:24:12.53,Default,,0,0,0,,他朋友和隐藏摄影机的摄影师
Dialogue: 0,0:24:12.53,0:24:16.05,Default,,0,0,0,,连手让名人相信他正在被整
Dialogue: 0,0:24:16.05,0:24:19.11,Default,,0,0,0,,名人每天在同一家餐厅吃饭
Dialogue: 0,0:24:19.11,0:24:22.07,Default,,0,0,0,,他深信整人地点在餐厅
Dialogue: 0,0:24:22.07,0:24:25.79,Default,,0,0,0,,其他人也让他这么以为
Dialogue: 0,0:24:25.79,0:24:29.48,Default,,0,0,0,,让他看见电视采访车和摄影机
Dialogue: 0,0:24:29.48,0:24:33.41,Default,,0,0,0,,并叫人在他面前做怪
Dialogue: 0,0:24:33.41,0:24:37.86,Default,,0,0,0,,名人装做什么也没看到
Dialogue: 0,0:24:37.86,0:24:41.38,Default,,0,0,0,,以为自己骗倒大家
Dialogue: 0,0:24:41.38,0:24:43.99,Default,,0,0,0,,其实他心里怕得要命
Dialogue: 0,0:24:43.99,0:24:46.53,Default,,0,0,0,,他们根本没准备要整他
Dialogue: 0,0:24:46.53,0:24:50.15,Default,,0,0,0,,只是等着拍下他出糗的画面
Dialogue: 0,0:24:50.15,0:24:53.35,Default,,0,0,0,,看到名人…妈的，你住手
Dialogue: 0,0:24:53.35,0:24:54.64,Default,,0,0,0,,不是我
Dialogue: 0,0:24:54.64,0:24:55.83,Default,,0,0,0,,那是谁？
Dialogue: 0,0:24:56.20,0:24:59.16,Default,,0,0,0,,我们看到名人满身是汗
Dialogue: 0,0:24:59.16,0:25:02.81,Default,,0,0,0,,每次侍者经过还得装酷
Dialogue: 0,0:25:02.81,0:25:05.56,Default,,0,0,0,,忽然有人走近他，要求签名
Dialogue: 0,0:25:05.56,0:25:08.21,Default,,0,0,0,,名人以为就是这人要整他
Dialogue: 0,0:25:08.21,0:25:11.37,Default,,0,0,0,,他冲向那人破口大骂
Dialogue: 0,0:25:11.37,0:25:14.26,Default,,0,0,0,,要求签名者不明白状况
Dialogue: 0,0:25:14.26,0:25:17.43,Default,,0,0,0,,两人一言不发打了起来
Dialogue: 0,0:25:17.43,0:25:21.12,Default,,0,0,0,,还是摄影师拉开他们
Dialogue: 0,0:25:21.12,0:25:24.64,Default,,0,0,0,,看他们打架真爽
Dialogue: 0,0:25:29.19,0:25:30.65,Default,,0,0,0,,结果呢
Dialogue: 0,0:25:30.65,0:25:33.38,Default,,0,0,0,,就结束了
Dialogue: 0,0:25:47.14,0:25:48.67,Default,,0,0,0,,名人是谁？
Dialogue: 0,0:25:48.67,0:25:54.05,Default,,0,0,0,,不知道，不过蛮有名的
Dialogue: 0,0:26:07.99,0:26:11.11,Default,,0,0,0,,又有人要闹事，我走了
Dialogue: 0,0:26:42.71,0:26:44.34,Default,,0,0,0,,他们想干嘛
Dialogue: 0,0:26:44.91,0:26:50.02,Default,,0,0,0,,君子报仇十年不晚！开玩笑的
Dialogue: 0,0:26:50.02,0:26:54.30,Default,,0,0,0,,阿布德的弟弟有空气枪
Dialogue: 0,0:26:54.30,0:26:56.23,Default,,0,0,0,,这下好玩了
Dialogue: 0,0:26:59.17,0:27:02.16,Default,,0,0,0,,想去医院看阿布德吗
Dialogue: 0,0:27:05.96,0:27:07.93,Default,,0,0,0,,先来看一样东西
Dialogue: 0,0:27:16.29,0:27:19.02,Default,,0,0,0,,真枪好炫！
Dialogue: 0,0:27:19.53,0:27:22.43,Default,,0,0,0,,妈的，它好美
Dialogue: 0,0:27:31.64,0:27:32.96,Default,,0,0,0,,你拿它干嘛
Dialogue: 0,0:27:32.96,0:27:34.14,Default,,0,0,0,,别闹
Dialogue: 0,0:27:34.14,0:27:35.60,Default,,0,0,0,,你拿它干嘛
Dialogue: 0,0:27:35.60,0:27:37.27,Default,,0,0,0,,阿布德死了就能派上用场
Dialogue: 0,0:27:37.27,0:27:39.26,Default,,0,0,0,,你想枪杀条子？
Dialogue: 0,0:27:39.71,0:27:41.66,Default,,0,0,0,,这是获得尊严的最佳办法
Dialogue: 0,0:27:41.66,0:27:43.40,Default,,0,0,0,,跟条子决斗能获得尊严？
Dialogue: 0,0:27:43.40,0:27:46.36,Default,,0,0,0,,不知道，至少能心理平衡
Dialogue: 0,0:27:46.36,0:27:48.03,Default,,0,0,0,,你要武器跟我拿就好了
Dialogue: 0,0:27:48.03,0:27:49.32,Default,,0,0,0,,这把不同
Dialogue: 0,0:27:49.73,0:27:51.40,Default,,0,0,0,,你在执行警务吗
Dialogue: 0,0:27:51.40,0:27:55.06,Default,,0,0,0,,我只是无意发现它，别臭脸
Dialogue: 0,0:27:55.51,0:27:57.18,Default,,0,0,0,,这对阿布德有好处？
Dialogue: 0,0:27:57.18,0:27:58.44,Default,,0,0,0,,对我们有好处
Dialogue: 0,0:28:01.53,0:28:02.64,Default,,0,0,0,,你干嘛这么冲
Dialogue: 0,0:28:02.64,0:28:04.35,Default,,0,0,0,,你太自以为是
Dialogue: 0,0:28:04.35,0:28:08.00,Default,,0,0,0,,我做我的事，你做你的事
Dialogue: 0,0:28:08.00,0:28:09.01,Default,,0,0,0,,我不想闹事
Dialogue: 0,0:28:09.01,0:28:11.60,Default,,0,0,0,,你闪边去
Dialogue: 0,0:28:15.41,0:28:20.35,Default,,0,0,0,,有了它，你就是这里的老大
Dialogue: 0,0:28:27.76,0:28:30.03,Default,,0,0,0,,雨贝，等等我
Dialogue: 0,0:28:40.32,0:28:41.85,Default,,0,0,0,,妈的
Dialogue: 0,0:28:48.36,0:28:50.59,Default,,0,0,0,,你在下蛋啊？还不快走
Dialogue: 0,0:28:50.59,0:28:52.92,Default,,0,0,0,,好啦，你火烧屁股吗
Dialogue: 0,0:29:27.47,0:29:29.07,Default,,0,0,0,,抱歉，你们不能进去
Dialogue: 0,0:29:29.07,0:29:30.95,Default,,0,0,0,,我们来看阿布德
Dialogue: 0,0:29:30.95,0:29:33.11,Default,,0,0,0,,抱歉，这是上面的命令
Dialogue: 0,0:29:33.11,0:29:35.83,Default,,0,0,0,,我们不是来闹事，看一下就走
Dialogue: 0,0:29:35.83,0:29:37.70,Default,,0,0,0,,我们是朋友
Dialogue: 0,0:29:37.70,0:29:40.11,Default,,0,0,0,,他陷于昏迷状态
Dialogue: 0,0:29:40.11,0:29:42.44,Default,,0,0,0,,医生也不会让你们进去
Dialogue: 0,0:29:42.44,0:29:44.70,Default,,0,0,0,,我们是朋友，不是来闹事
Dialogue: 0,0:29:44.70,0:29:47.31,Default,,0,0,0,,我让你们进去会被开除
Dialogue: 0,0:29:47.31,0:29:49.33,Default,,0,0,0,,狗腿子
Dialogue: 0,0:29:49.33,0:29:51.21,Default,,0,0,0,,请别大声说话
Dialogue: 0,0:29:51.21,0:29:52.42,Default,,0,0,0,,会打扰到他的家人
Dialogue: 0,0:29:52.42,0:29:55.83,Default,,0,0,0,,你确定不放我们进去是对的？
Dialogue: 0,0:29:55.83,0:29:57.82,Default,,0,0,0,,请你们快离开
Dialogue: 0,0:29:57.82,0:30:00.60,Default,,0,0,0,,你的手在干嘛？想推我去哪？
Dialogue: 0,0:30:00.60,0:30:03.63,Default,,0,0,0,,拿你的脏枪打死我
Dialogue: 0,0:30:03.63,0:30:05.96,Default,,0,0,0,,小丑，拿出枪啊！
Dialogue: 0,0:30:05.96,0:30:07.94,Default,,0,0,0,,怎么回事？
Dialogue: 0,0:30:07.94,0:30:09.47,Default,,0,0,0,,我们是来看朋友的
Dialogue: 0,0:30:09.47,0:30:12.71,Default,,0,0,0,,怎么回事？
Dialogue: 0,0:30:12.71,0:30:15.63,Default,,0,0,0,,没看到阿布德绝不走
Dialogue: 0,0:30:15.63,0:30:16.92,Default,,0,0,0,,快走，不然逮捕你们
Dialogue: 0,0:30:16.92,0:30:18.45,Default,,0,0,0,,你要逮捕谁？闭嘴！
Dialogue: 0,0:30:18.45,0:30:21.37,Default,,0,0,0,,把另外两个拉开
Dialogue: 0,0:30:21.37,0:30:24.68,Default,,0,0,0,,冷静一点
Dialogue: 0,0:30:24.68,0:30:28.61,Default,,0,0,0,,警官，这三人吵闹滋事
Dialogue: 0,0:30:28.61,0:30:31.85,Default,,0,0,0,,我逮捕了他们的老大
Dialogue: 0,0:30:31.85,0:30:33.66,Default,,0,0,0,,他什么也没做
Dialogue: 0,0:30:33.66,0:30:35.33,Default,,0,0,0,,我逮捕了老大
Dialogue: 0,0:30:35.33,0:30:36.82,Default,,0,0,0,,扎伊尔是老大？
Dialogue: 0,0:30:36.82,0:30:44.66,Default,,0,0,0,,我才是
Dialogue: 0,0:30:58.19,0:31:01.39,Default,,0,0,0,,你们胡作非为还不肯认错
Dialogue: 0,0:31:01.39,0:31:03.62,Default,,0,0,0,,硬要闯进病房
Dialogue: 0,0:31:03.62,0:31:05.74,Default,,0,0,0,,他们只是尽守本份
Dialogue: 0,0:31:05.74,0:31:07.33,Default,,0,0,0,,听你在放屁
Dialogue: 0,0:31:07.41,0:31:10.30,Default,,0,0,0,,混蛋，你给我闭嘴
Dialogue: 0,0:31:10.30,0:31:11.72,Default,,0,0,0,,你才闭嘴
Dialogue: 0,0:31:11.72,0:31:13.01,Default,,0,0,0,,嘴巴放干净点
Dialogue: 0,0:31:13.01,0:31:14.44,Default,,0,0,0,,你才嘴巴放干净
Dialogue: 0,0:31:14.44,0:31:16.98,Default,,0,0,0,,妈的，不要再讲了
Dialogue: 0,0:31:16.98,0:31:18.82,Default,,0,0,0,,你什么都不懂
Dialogue: 0,0:31:18.82,0:31:20.08,Default,,0,0,0,,你又懂了？
Dialogue: 0,0:31:20.08,0:31:22.13,Default,,0,0,0,,白痴，闭嘴
Dialogue: 0,0:31:22.13,0:31:24.69,Default,,0,0,0,,对我客气点
Dialogue: 0,0:31:25.33,0:31:27.35,Default,,0,0,0,,别跟我这样讲话
Dialogue: 0,0:31:27.35,0:31:28.91,Default,,0,0,0,,欺负阿布德的警察会被判刑的
Dialogue: 0,0:31:28.91,0:31:30.62,Default,,0,0,0,,少做梦
Dialogue: 0,0:31:30.62,0:31:34.25,Default,,0,0,0,,医院里的警察是在保护阿布德
Dialogue: 0,0:31:36.46,0:31:40.22,Default,,0,0,0,,你老是混淆一切，惹事生非
Dialogue: 0,0:31:40.22,0:31:42.07,Default,,0,0,0,,那些警察是在保护阿布德
Dialogue: 0,0:31:42.07,0:31:44.57,Default,,0,0,0,,大部分警察是人民保母
Dialogue: 0,0:31:44.57,0:31:47.77,Default,,0,0,0,,谁来保护我们免于你们的魔掌
Dialogue: 0,0:31:47.77,0:31:49.80,Default,,0,0,0,,叫他们别再干蠢事
Dialogue: 0,0:31:51.39,0:31:52.83,Default,,0,0,0,,这句台词讲得真流利
Dialogue: 0,0:33:11.77,0:33:13.62,Default,,0,0,0,,管好你的舌头！
Dialogue: 0,0:33:13.62,0:33:15.50,Default,,0,0,0,,王八，你也一样
Dialogue: 0,0:33:15.50,0:33:17.37,Default,,0,0,0,,下次再让我没面子
Dialogue: 0,0:33:17.37,0:33:20.61,Default,,0,0,0,,我会让你在警局内屁滚尿流
Dialogue: 0,0:33:22.25,0:33:26.18,Default,,0,0,0,,慢慢等你哥去救你
Dialogue: 0,0:33:26.18,0:33:29.28,Default,,0,0,0,,我又没叫你救我
Dialogue: 0,0:33:29.28,0:33:32.30,Default,,0,0,0,,白痴，我是替你哥着想
Dialogue: 0,0:33:32.30,0:33:35.43,Default,,0,0,0,,我怕他把你宰了
Dialogue: 0,0:33:36.10,0:33:37.19,Default,,0,0,0,,鸡婆
Dialogue: 0,0:33:43.40,0:33:45.32,Default,,0,0,0,,我知道拳击馆被烧的事
Dialogue: 0,0:33:45.32,0:33:49.45,Default,,0,0,0,,我能帮你介绍去健身房工作
Dialogue: 0,0:33:50.54,0:33:54.19,Default,,0,0,0,,我不做了，大家已不想打沙包
Dialogue: 0,0:33:54.19,0:33:56.94,Default,,0,0,0,,我以前还能跟他们沟通
Dialogue: 0,0:33:56.94,0:33:58.75,Default,,0,0,0,,现在没辙了
Dialogue: 0,0:33:58.75,0:34:01.18,Default,,0,0,0,,我还能忍受这些
Dialogue: 0,0:34:01.18,0:34:03.72,Default,,0,0,0,,新进的警察可撑不了一个月
Dialogue: 0,0:34:03.72,0:34:06.52,Default,,0,0,0,,阿拉伯人在警界撑不了一小时
Dialogue: 0,0:34:07.79,0:34:11.38,Default,,0,0,0,,我走了，你们少冲动
Dialogue: 0,0:34:11.38,0:34:12.74,Default,,0,0,0,,我们会尽量
Dialogue: 0,0:34:12.74,0:34:17.11,Default,,0,0,0,,小王八，别再跟我说话，懂吗
Dialogue: 0,0:34:17.61,0:34:18.57,Default,,0,0,0,,好啦
Dialogue: 0,0:34:20.64,0:34:21.92,Default,,0,0,0,,干嘛跟他握手？
Dialogue: 0,0:34:21.92,0:34:25.23,Default,,0,0,0,,有啥关系？他向来很正直
Dialogue: 0,0:34:25.23,0:34:27.18,Default,,0,0,0,,正直个屁，别跟条子握手
Dialogue: 0,0:34:27.18,0:34:28.85,Default,,0,0,0,,有种就宰了他
Dialogue: 0,0:34:28.85,0:34:30.41,Default,,0,0,0,,你的想法真幼稚
Dialogue: 0,0:34:30.41,0:34:31.59,Default,,0,0,0,,你真是没神经
Dialogue: 0,0:34:31.59,0:34:32.81,Default,,0,0,0,,我就知道！
Dialogue: 0,0:34:32.81,0:34:34.66,Default,,0,0,0,,你在医院时就怪怪的，给我看
Dialogue: 0,0:34:34.66,0:34:35.98,Default,,0,0,0,,别激动
Dialogue: 0,0:34:35.98,0:34:37.62,Default,,0,0,0,,给我看
Dialogue: 0,0:34:37.62,0:34:39.49,Default,,0,0,0,,你事前没告诉我们
Dialogue: 0,0:34:39.49,0:34:41.13,Default,,0,0,0,,我以为你不想知道
Dialogue: 0,0:34:41.13,0:34:43.11,Default,,0,0,0,,因为我不晓得你会这么蠢
Dialogue: 0,0:34:43.11,0:34:45.55,Default,,0,0,0,,你少念我，我已经够大
Dialogue: 0,0:34:45.55,0:34:51.01,Default,,0,0,0,,我不想念你，我想海K你
Dialogue: 0,0:34:55.36,0:34:57.33,Default,,0,0,0,,雨贝，住手
Dialogue: 0,0:34:57.90,0:35:01.14,Default,,0,0,0,,你有枪就屌了起来？我扁死你
Dialogue: 0,0:35:01.14,0:35:03.75,Default,,0,0,0,,你要扁死谁？
Dialogue: 0,0:35:03.75,0:35:07.31,Default,,0,0,0,,雨贝够了！我们去吃东西
Dialogue: 0,0:35:07.96,0:35:09.52,Default,,0,0,0,,给我闭嘴！我闪人了
Dialogue: 0,0:35:09.52,0:35:10.95,Default,,0,0,0,,快闪！
Dialogue: 0,0:35:10.95,0:35:11.72,Default,,0,0,0,,别这样，回来
Dialogue: 0,0:35:11.72,0:35:13.53,Default,,0,0,0,,雨贝，回来
Dialogue: 0,0:35:13.53,0:35:15.09,Default,,0,0,0,,让他走
Dialogue: 0,0:35:15.09,0:35:17.00,Default,,0,0,0,,妈的，你别走
Dialogue: 0,0:35:17.00,0:35:18.56,Default,,0,0,0,,放开我
Dialogue: 0,0:35:22.40,0:35:24.42,Default,,0,0,0,,雨贝最近是怎么了
Dialogue: 0,0:35:27.10,0:35:29.06,Default,,0,0,0,,别理他，他想太多了
Dialogue: 0,0:35:45.54,0:35:46.48,Default,,0,0,0,,妈妈在哪
Dialogue: 0,0:35:46.48,0:35:47.76,Default,,0,0,0,,这是什么意思？
Dialogue: 0,0:35:47.76,0:35:48.82,Default,,0,0,0,,我没空
Dialogue: 0,0:35:57.65,0:35:58.55,Default,,0,0,0,,如何？
Dialogue: 0,0:35:59.32,0:36:00.26,Default,,0,0,0,,我没空
Dialogue: 0,0:36:00.26,0:36:01.47,Default,,0,0,0,,答案是什么？
Dialogue: 0,0:36:01.47,0:36:02.62,Default,,0,0,0,,我不知道
Dialogue: 0,0:36:02.62,0:36:03.46,Default,,0,0,0,,你什么都不知道
Dialogue: 0,0:36:03.46,0:36:05.34,Default,,0,0,0,,你说得对
Dialogue: 0,0:36:05.34,0:36:06.14,Default,,0,0,0,,妈，你好
Dialogue: 0,0:36:06.14,0:36:07.08,Default,,0,0,0,,小弟好吗
Dialogue: 0,0:36:07.08,0:36:08.51,Default,,0,0,0,,他很好
Dialogue: 0,0:36:08.92,0:36:13.05,Default,,0,0,0,,不过在坐牢的那个不太好
Dialogue: 0,0:36:13.93,0:36:15.67,Default,,0,0,0,,马斯又怎么了
Dialogue: 0,0:36:15.67,0:36:17.76,Default,,0,0,0,,他写信说需要课本
Dialogue: 0,0:36:18.14,0:36:18.87,Default,,0,0,0,,干嘛用？
Dialogue: 0,0:36:19.57,0:36:23.27,Default,,0,0,0,,大概想趁坐牢准备大学联考
Dialogue: 0,0:36:25.59,0:36:28.49,Default,,0,0,0,,他高一被当还想考大学？
Dialogue: 0,0:36:29.94,0:36:31.67,Default,,0,0,0,,别想偷吃
Dialogue: 0,0:36:32.76,0:36:33.85,Default,,0,0,0,,没有啊
Dialogue: 0,0:36:34.39,0:36:37.04,Default,,0,0,0,,不过我没钱买书
Dialogue: 0,0:36:37.04,0:36:39.06,Default,,0,0,0,,我有钱付瓦斯费
Dialogue: 0,0:36:39.99,0:36:41.52,Default,,0,0,0,,那我的机器呢？
Dialogue: 0,0:36:47.65,0:36:50.19,Default,,0,0,0,,什么机器？
Dialogue: 0,0:36:50.19,0:36:53.35,Default,,0,0,0,,你不晓得我要买新的裁缝车？
Dialogue: 0,0:36:53.95,0:36:56.87,Default,,0,0,0,,妈的，忘了跟达弟说这件事
Dialogue: 0,0:36:56.87,0:36:58.80,Default,,0,0,0,,这台快寿终正寝了
Dialogue: 0,0:36:59.24,0:37:01.20,Default,,0,0,0,,派图，去你房间做功课
Dialogue: 0,0:37:01.71,0:37:02.67,Default,,0,0,0,,妈…
Dialogue: 0,0:37:03.03,0:37:04.43,Default,,0,0,0,,别讨价还价
Dialogue: 0,0:37:05.64,0:37:08.46,Default,,0,0,0,,谁是达弟？B栋的销赃王？
Dialogue: 0,0:37:08.46,0:37:10.09,Default,,0,0,0,,不，是D栋的
Dialogue: 0,0:37:10.44,0:37:13.71,Default,,0,0,0,,不认识，他有办法弄到课本吗
Dialogue: 0,0:37:14.30,0:37:16.46,Default,,0,0,0,,他又不是开书店的
Dialogue: 0,0:37:20.71,0:37:22.10,Default,,0,0,0,,官方消息指出
Dialogue: 0,0:37:22.10,0:37:24.81,Default,,0,0,0,,昨晚在暴动中遗失的警枪
Dialogue: 0,0:37:24.81,0:37:26.66,Default,,0,0,0,,一直未寻获
Dialogue: 0,0:37:26.66,0:37:29.65,Default,,0,0,0,,我们访问了居民
Dialogue: 0,0:37:29.65,0:37:31.35,Default,,0,0,0,,谈谈他们对这件事的看法
Dialogue: 0,0:37:31.35,0:37:32.61,Default,,0,0,0,,真是该死！
Dialogue: 0,0:37:32.61,0:37:34.67,Default,,0,0,0,,他们烧了拳击馆？
Dialogue: 0,0:37:35.95,0:37:38.38,Default,,0,0,0,,我受够了这个地方
Dialogue: 0,0:37:38.38,0:37:42.04,Default,,0,0,0,,它全变了，我要离开这里
Dialogue: 0,0:37:42.04,0:37:44.66,Default,,0,0,0,,我相信文兹也参与烧毁拳击馆
Dialogue: 0,0:37:45.65,0:37:47.59,Default,,0,0,0,,他变坏了
Dialogue: 0,0:37:49.62,0:37:51.85,Default,,0,0,0,,我一定要离开这里
Dialogue: 0,0:37:54.22,0:37:57.67,Default,,0,0,0,,好！路过杂货店时买个色拉
Dialogue: 0,0:37:58.39,0:37:59.54,Default,,0,0,0,,不行
Dialogue: 0,0:37:59.54,0:38:02.15,Default,,0,0,0,,我外婆每天来这里买菜
Dialogue: 0,0:38:02.15,0:38:03.89,Default,,0,0,0,,你总能少算二块吧！
Dialogue: 0,0:38:03.89,0:38:05.38,Default,,0,0,0,,你外婆跟你是两回事
Dialogue: 0,0:38:05.38,0:38:07.96,Default,,0,0,0,,小气！你有二块吗？
Dialogue: 0,0:38:07.96,0:38:09.80,Default,,0,0,0,,只有一块
Dialogue: 0,0:38:09.80,0:38:11.58,Default,,0,0,0,,一块可以吗？
Dialogue: 0,0:38:11.58,0:38:12.80,Default,,0,0,0,,不行
Dialogue: 0,0:38:12.80,0:38:15.93,Default,,0,0,0,,少吹胡子瞪眼，给我一块
Dialogue: 0,0:38:15.93,0:38:18.43,Default,,0,0,0,,我才不要
Dialogue: 0,0:38:18.43,0:38:20.21,Default,,0,0,0,,给我记住！
Dialogue: 0,0:38:20.21,0:38:22.05,Default,,0,0,0,,你要什么？我看到了！
Dialogue: 0,0:38:22.05,0:38:24.52,Default,,0,0,0,,给我红的，它们比较便宜
Dialogue: 0,0:38:25.29,0:38:27.83,Default,,0,0,0,,我会被骂死，外婆讨厌红的
Dialogue: 0,0:38:27.83,0:38:29.82,Default,,0,0,0,,给他一枪你就能拿绿的
Dialogue: 0,0:38:30.75,0:38:33.05,Default,,0,0,0,,你外婆会很高兴
Dialogue: 0,0:38:33.05,0:38:34.54,Default,,0,0,0,,我要成仙了
Dialogue: 0,0:38:34.54,0:38:39.50,Default,,0,0,0,,真是他妈的爽
Dialogue: 0,0:42:02.56,0:42:03.89,Default,,0,0,0,,扎伊尔
Dialogue: 0,0:42:04.58,0:42:06.20,Default,,0,0,0,,闭嘴
Dialogue: 0,0:42:15.33,0:42:19.78,Default,,0,0,0,,有一头母牛！
Dialogue: 0,0:42:19.78,0:42:21.22,Default,,0,0,0,,少臭盖
Dialogue: 0,0:42:21.97,0:42:23.19,Default,,0,0,0,,我发誓…
Dialogue: 0,0:42:23.19,0:42:25.38,Default,,0,0,0,,来帮我剪头发
Dialogue: 0,0:42:25.38,0:42:27.47,Default,,0,0,0,,跟昨天那只一样
Dialogue: 0,0:42:27.47,0:42:28.59,Default,,0,0,0,,你才是牛
Dialogue: 0,0:42:28.59,0:42:30.39,Default,,0,0,0,,妈的，我真的看见牠
Dialogue: 0,0:42:30.39,0:42:33.04,Default,,0,0,0,,你不相信我？
Dialogue: 0,0:42:33.04,0:42:35.67,Default,,0,0,0,,闭嘴
Dialogue: 0,0:42:45.98,0:42:48.63,Default,,0,0,0,,白痴老兄
Dialogue: 0,0:42:48.63,0:42:49.57,Default,,0,0,0,,我要宰了你们
Dialogue: 0,0:42:49.57,0:42:51.62,Default,,0,0,0,,外婆，我知道它们是红的
Dialogue: 0,0:42:51.62,0:42:53.74,Default,,0,0,0,,黑夜中看见母牛这件事
Dialogue: 0,0:42:53.74,0:42:58.58,Default,,0,0,0,,我觉得很怪
Dialogue: 0,0:42:59.21,0:43:00.67,Default,,0,0,0,,文兹，别剃坏了
Dialogue: 0,0:43:01.99,0:43:04.18,Default,,0,0,0,,我心情很糟！别剃坏了
Dialogue: 0,0:43:04.18,0:43:06.97,Default,,0,0,0,,我又不叫柏克斯，我尽力就是
Dialogue: 0,0:43:06.97,0:43:08.06,Default,,0,0,0,,柏克斯？
Dialogue: 0,0:43:08.50,0:43:09.66,Default,,0,0,0,,坐下
Dialogue: 0,0:43:10.72,0:43:12.08,Default,,0,0,0,,好炫喔！
Dialogue: 0,0:43:12.08,0:43:12.99,Default,,0,0,0,,炫什么？
Dialogue: 0,0:43:12.99,0:43:14.73,Default,,0,0,0,,条子的枪
Dialogue: 0,0:43:14.73,0:43:17.30,Default,,0,0,0,,别一直动，你好烦
Dialogue: 0,0:43:17.30,0:43:18.62,Default,,0,0,0,,轻点，不然宰了你
Dialogue: 0,0:43:18.62,0:43:20.99,Default,,0,0,0,,别动
Dialogue: 0,0:43:20.99,0:43:25.06,Default,,0,0,0,,阿布德若死了，你会宰条子吗
Dialogue: 0,0:43:25.06,0:43:27.84,Default,,0,0,0,,你想当下一个牺牲品？
Dialogue: 0,0:43:27.84,0:43:28.57,Default,,0,0,0,,不想
Dialogue: 0,0:43:28.57,0:43:29.65,Default,,0,0,0,,我也不想
Dialogue: 0,0:43:29.65,0:43:31.25,Default,,0,0,0,,你也不想当下一个牺牲品？
Dialogue: 0,0:43:31.25,0:43:33.03,Default,,0,0,0,,没错，他们以为我在开玩笑
Dialogue: 0,0:43:33.03,0:43:37.90,Default,,0,0,0,,告诉你，我是认真的
Dialogue: 0,0:43:40.23,0:43:42.04,Default,,0,0,0,,轻一点
Dialogue: 0,0:43:42.04,0:43:44.27,Default,,0,0,0,,好啦
Dialogue: 0,0:43:44.27,0:43:46.46,Default,,0,0,0,,条子也有枪…你做了什么？
Dialogue: 0,0:43:46.46,0:43:48.51,Default,,0,0,0,,我发毒誓，啥也没有
Dialogue: 0,0:43:48.51,0:43:50.18,Default,,0,0,0,,你干嘛发毒誓？
Dialogue: 0,0:43:50.18,0:43:52.41,Default,,0,0,0,,因为我什么也没做
Dialogue: 0,0:43:52.41,0:43:54.08,Default,,0,0,0,,那为什么好冷？
Dialogue: 0,0:43:54.08,0:43:56.06,Default,,0,0,0,,因为这里很冷
Dialogue: 0,0:43:56.06,0:43:57.46,Default,,0,0,0,,这里会冷？
Dialogue: 0,0:43:57.46,0:44:01.04,Default,,0,0,0,,放心，我会剪齐
Dialogue: 0,0:44:01.04,0:44:04.66,Default,,0,0,0,,齐你妈，让我看看
Dialogue: 0,0:44:04.66,0:44:07.48,Default,,0,0,0,,不信你自己看
Dialogue: 0,0:44:07.48,0:44:08.56,Default,,0,0,0,,我没看到
Dialogue: 0,0:44:08.56,0:44:09.84,Default,,0,0,0,,你瞎了吗
Dialogue: 0,0:44:09.84,0:44:10.85,Default,,0,0,0,,我看不到
Dialogue: 0,0:44:10.85,0:44:12.21,Default,,0,0,0,,相信我
Dialogue: 0,0:44:12.21,0:44:13.60,Default,,0,0,0,,什么话？
Dialogue: 0,0:44:13.60,0:44:16.28,Default,,0,0,0,,这个洞正典又不明显
Dialogue: 0,0:44:16.28,0:44:17.67,Default,,0,0,0,,为什么好冷？
Dialogue: 0,0:44:17.67,0:44:20.07,Default,,0,0,0,,相信我，再烦就不帮你剪
Dialogue: 0,0:44:23.17,0:44:25.05,Default,,0,0,0,,扎伊尔，回来
Dialogue: 0,0:44:25.05,0:44:26.75,Default,,0,0,0,,滚远一点
Dialogue: 0,0:44:26.75,0:44:28.39,Default,,0,0,0,,你实在很烦
Dialogue: 0,0:44:28.39,0:44:32.77,Default,,0,0,0,,这是纽约最新发型，炫毙了
Dialogue: 0,0:44:32.77,0:44:34.87,Default,,0,0,0,,你别再赌气
Dialogue: 0,0:44:35.24,0:44:36.04,Default,,0,0,0,,纽约？
Dialogue: 0,0:44:36.04,0:44:36.60,Default,,0,0,0,,对！
Dialogue: 0,0:44:36.60,0:44:38.06,Default,,0,0,0,,我听你在放屁
Dialogue: 0,0:44:38.06,0:44:40.12,Default,,0,0,0,,我跟庞克没两样
Dialogue: 0,0:44:40.12,0:44:41.75,Default,,0,0,0,,我对天发誓
Dialogue: 0,0:44:41.75,0:44:42.62,Default,,0,0,0,,不好笑
Dialogue: 0,0:44:42.62,0:44:45.16,Default,,0,0,0,,亲我一下
Dialogue: 0,0:44:45.16,0:44:47.32,Default,,0,0,0,,滚远一点
Dialogue: 0,0:44:47.32,0:44:49.37,Default,,0,0,0,,你这么会记恨，真不上道
Dialogue: 0,0:44:49.37,0:44:52.07,Default,,0,0,0,,兄弟，还在生气？
Dialogue: 0,0:45:02.77,0:45:03.89,Default,,0,0,0,,是你妹
Dialogue: 0,0:45:12.96,0:45:15.40,Default,,0,0,0,,你在这干嘛？
Dialogue: 0,0:45:15.40,0:45:17.91,Default,,0,0,0,,你跟朋友在这干嘛？
Dialogue: 0,0:45:17.91,0:45:20.27,Default,,0,0,0,,不去上课在这鬼混
Dialogue: 0,0:45:20.27,0:45:23.90,Default,,0,0,0,,臭娘们快滚
Dialogue: 0,0:45:25.28,0:45:26.67,Default,,0,0,0,,你还在？
Dialogue: 0,0:45:26.67,0:45:28.54,Default,,0,0,0,,你冷静点
Dialogue: 0,0:45:29.21,0:45:33.25,Default,,0,0,0,,你干嘛跟我朋友讲话？
Dialogue: 0,0:45:33.25,0:45:36.14,Default,,0,0,0,,我高兴跟文森讲话又怎样？
Dialogue: 0,0:45:36.14,0:45:38.33,Default,,0,0,0,,他不叫文森，他叫文兹
Dialogue: 0,0:45:38.33,0:45:40.84,Default,,0,0,0,,少用这种态度我说话，滚！
Dialogue: 0,0:45:40.84,0:45:42.44,Default,,0,0,0,,干嘛这样推我
Dialogue: 0,0:45:42.44,0:45:45.92,Default,,0,0,0,,你们今晚跟我去吗
Dialogue: 0,0:45:45.92,0:45:48.56,Default,,0,0,0,,去哪？
Dialogue: 0,0:45:48.56,0:45:51.27,Default,,0,0,0,,巴黎市，那里有械斗
Dialogue: 0,0:45:51.27,0:45:52.53,Default,,0,0,0,,还有位子？
Dialogue: 0,0:45:52.53,0:45:54.19,Default,,0,0,0,,免费载你们去
Dialogue: 0,0:45:55.94,0:45:58.34,Default,,0,0,0,,够意思
Dialogue: 0,0:46:00.22,0:46:02.48,Default,,0,0,0,,她真不懂得敬老尊贤
Dialogue: 0,0:47:09.18,0:47:10.15,Default,,0,0,0,,有暴动！
Dialogue: 0,0:47:21.57,0:47:23.66,Default,,0,0,0,,王八，记得我哥吗？
Dialogue: 0,0:47:23.66,0:47:25.82,Default,,0,0,0,,替阿布德报仇
Dialogue: 0,0:47:25.82,0:47:27.97,Default,,0,0,0,,快开车
Dialogue: 0,0:47:27.97,0:47:29.92,Default,,0,0,0,,混账，出来
Dialogue: 0,0:47:29.92,0:47:31.25,Default,,0,0,0,,别动
Dialogue: 0,0:47:31.25,0:47:32.39,Default,,0,0,0,,别动
Dialogue: 0,0:47:32.39,0:47:34.24,Default,,0,0,0,,快滚
Dialogue: 0,0:47:34.24,0:47:36.90,Default,,0,0,0,,畜牲，快滚
Dialogue: 0,0:48:34.75,0:48:36.84,Default,,0,0,0,,文兹，雨贝，过来
Dialogue: 0,0:48:36.84,0:48:37.93,Default,,0,0,0,,往左边
Dialogue: 0,0:48:38.37,0:48:41.06,Default,,0,0,0,,这边
Dialogue: 0,0:48:44.18,0:48:45.11,Default,,0,0,0,,别动
Dialogue: 0,0:48:48.28,0:48:49.77,Default,,0,0,0,,你疯了吗？
Dialogue: 0,0:48:50.51,0:48:52.81,Default,,0,0,0,,你们搞什么？
Dialogue: 0,0:48:56.46,0:48:57.95,Default,,0,0,0,,我们操赢你了！
Dialogue: 0,0:49:04.12,0:49:07.25,Default,,0,0,0,,我枪口对着那条子
Dialogue: 0,0:49:07.25,0:49:11.04,Default,,0,0,0,,像这样抓起他
Dialogue: 0,0:49:11.04,0:49:12.33,Default,,0,0,0,,我根本不怕
Dialogue: 0,0:49:12.33,0:49:14.97,Default,,0,0,0,,那条子吓得屁滚尿流
Dialogue: 0,0:49:14.97,0:49:16.92,Default,,0,0,0,,要不是雨贝在场
Dialogue: 0,0:49:16.92,0:49:20.65,Default,,0,0,0,,我一定一枪打烂他
Dialogue: 0,0:49:20.65,0:49:24.51,Default,,0,0,0,,雨贝一拳把他的头打歪
Dialogue: 0,0:49:24.51,0:49:25.48,Default,,0,0,0,,我发誓是真的
Dialogue: 0,0:49:25.48,0:49:27.71,Default,,0,0,0,,你们打条子？
Dialogue: 0,0:49:27.71,0:49:30.11,Default,,0,0,0,,雨贝狠狠地K他，真爽
Dialogue: 0,0:49:30.11,0:49:32.75,Default,,0,0,0,,然后呢？
Dialogue: 0,0:49:32.75,0:49:35.38,Default,,0,0,0,,我们就跑了
Dialogue: 0,0:49:38.95,0:49:43.32,Default,,0,0,0,,“世界属于你们”
Dialogue: 0,0:50:22.10,0:50:23.12,Default,,0,0,0,,现在要干嘛？
Dialogue: 0,0:50:27.07,0:50:30.17,Default,,0,0,0,,我要打电话，拿回我的钱
Dialogue: 0,0:50:34.52,0:50:38.72,Default,,0,0,0,,喂，请查亚斯戴的地址
Dialogue: 0,0:50:39.53,0:50:42.09,Default,,0,0,0,,我可以等，不过别太久
Dialogue: 0,0:50:44.85,0:50:46.80,Default,,0,0,0,,一瓶饮料十五元
Dialogue: 0,0:50:46.80,0:50:48.53,Default,,0,0,0,,今晚我一定要拿到钱
Dialogue: 0,0:50:49.34,0:50:51.47,Default,,0,0,0,,文兹，想喝巧克力牛奶吗？
Dialogue: 0,0:50:52.33,0:50:52.89,Default,,0,0,0,,不要？
Dialogue: 0,0:50:52.89,0:50:53.45,Default,,0,0,0,,不要
Dialogue: 0,0:50:53.45,0:50:54.21,Default,,0,0,0,,确定？
Dialogue: 0,0:50:54.21,0:50:54.80,Default,,0,0,0,,对
Dialogue: 0,0:50:54.80,0:50:56.40,Default,,0,0,0,,喝一点？
Dialogue: 0,0:50:56.40,0:50:59.26,Default,,0,0,0,,老雨，要喝…
Dialogue: 0,0:50:59.26,0:51:00.75,Default,,0,0,0,,算了，你已经够黑
Dialogue: 0,0:51:06.95,0:51:08.81,Default,,0,0,0,,你们要臭脸多久？
Dialogue: 0,0:51:11.05,0:51:14.22,Default,,0,0,0,,我又没臭脸
Dialogue: 0,0:51:14.22,0:51:15.96,Default,,0,0,0,,我不信
Dialogue: 0,0:51:15.96,0:51:18.05,Default,,0,0,0,,你们…两个小孩真可笑
Dialogue: 0,0:51:18.05,0:51:18.95,Default,,0,0,0,,谁是小孩？
Dialogue: 0,0:51:18.95,0:51:21.84,Default,,0,0,0,,“两个”为蠢事赌气的小孩
Dialogue: 0,0:51:21.84,0:51:24.33,Default,,0,0,0,,我完全赞同
Dialogue: 0,0:51:25.15,0:51:27.78,Default,,0,0,0,,想杀条子的确很蠢
Dialogue: 0,0:51:28.73,0:51:32.14,Default,,0,0,0,,扎伊尔，叫你兄弟少啰唆
Dialogue: 0,0:51:32.14,0:51:33.08,Default,,0,0,0,,我又没说过要杀条子
Dialogue: 0,0:51:33.08,0:51:33.92,Default,,0,0,0,,你说过
Dialogue: 0,0:51:33.92,0:51:34.58,Default,,0,0,0,,没有
Dialogue: 0,0:51:34.58,0:51:35.06,Default,,0,0,0,,有
Dialogue: 0,0:51:35.06,0:51:35.86,Default,,0,0,0,,没有
Dialogue: 0,0:51:35.86,0:51:37.15,Default,,0,0,0,,有
Dialogue: 0,0:51:37.15,0:51:38.30,Default,,0,0,0,,没有！我不是这样说
Dialogue: 0,0:51:38.30,0:51:40.28,Default,,0,0,0,,我说若阿布德死了我会宰条子
Dialogue: 0,0:51:40.28,0:51:42.48,Default,,0,0,0,,又不是为了好玩
Dialogue: 0,0:51:42.48,0:51:44.88,Default,,0,0,0,,刚才要不是我有枪
Dialogue: 0,0:51:44.88,0:51:47.14,Default,,0,0,0,,早就被镇暴警察打死
Dialogue: 0,0:51:47.14,0:51:49.12,Default,,0,0,0,,我又不是王丹
Dialogue: 0,0:51:49.12,0:51:51.00,Default,,0,0,0,,你们完全不同
Dialogue: 0,0:51:51.00,0:51:54.17,Default,,0,0,0,,你以为我们会可怜你？
Dialogue: 0,0:51:54.17,0:51:58.73,Default,,0,0,0,,我又没叫你们这些狗腿帮忙
Dialogue: 0,0:52:00.60,0:52:02.57,Default,,0,0,0,,尽量笑吧！
Dialogue: 0,0:52:03.21,0:52:06.31,Default,,0,0,0,,我受够了这个王八社会
Dialogue: 0,0:52:06.31,0:52:11.25,Default,,0,0,0,,我们像是阴沟里的老鼠
Dialogue: 0,0:52:11.81,0:52:13.61,Default,,0,0,0,,你有办法改变吗？
Dialogue: 0,0:52:14.04,0:52:15.67,Default,,0,0,0,,你们得过且过
Dialogue: 0,0:52:15.67,0:52:18.94,Default,,0,0,0,,朋友一场，我要告诉你们
Dialogue: 0,0:52:18.94,0:52:20.72,Default,,0,0,0,,若阿布德死了
Dialogue: 0,0:52:20.72,0:52:22.18,Default,,0,0,0,,我会改变现状，枪杀条子
Dialogue: 0,0:52:22.87,0:52:25.90,Default,,0,0,0,,让他们彻底明白情势已不同
Dialogue: 0,0:52:26.70,0:52:29.21,Default,,0,0,0,,别胡来！你刚才讲的话
Dialogue: 0,0:52:29.21,0:52:31.64,Default,,0,0,0,,非常的强硬派
Dialogue: 0,0:52:31.64,0:52:34.74,Default,,0,0,0,,文兹你太偏激，别再插手
Dialogue: 0,0:52:34.74,0:52:38.36,Default,,0,0,0,,阿布德死了你是不是少个兄弟
Dialogue: 0,0:52:38.36,0:52:39.02,Default,,0,0,0,,对
Dialogue: 0,0:52:39.02,0:52:41.21,Default,,0,0,0,,他杀了条子就少个条子？
Dialogue: 0,0:52:41.21,0:52:42.15,Default,,0,0,0,,对
Dialogue: 0,0:52:42.15,0:52:46.40,Default,,0,0,0,,但孤军奋斗无法杀光所有条子
Dialogue: 0,0:52:46.40,0:52:48.55,Default,,0,0,0,,你是公民课老师吗？
Dialogue: 0,0:52:48.55,0:52:51.13,Default,,0,0,0,,永远都是你说的才对
Dialogue: 0,0:52:51.13,0:52:54.26,Default,,0,0,0,,为什么你老是帮那些杂种
Dialogue: 0,0:52:54.26,0:52:58.09,Default,,0,0,0,,杂种？你要是念过书就该明白
Dialogue: 0,0:52:58.09,0:52:59.31,Default,,0,0,0,,冤冤相报何时了
Dialogue: 0,0:52:59.31,0:53:02.75,Default,,0,0,0,,我没念过书，我在街头混大的
Dialogue: 0,0:53:02.75,0:53:06.30,Default,,0,0,0,,知道我在街头学到什么？
Dialogue: 0,0:53:06.30,0:53:11.31,Default,,0,0,0,,一旦低头永劫不复
Dialogue: 0,0:53:11.31,0:53:14.76,Default,,0,0,0,,你刚用警枪指着条子
Dialogue: 0,0:53:14.76,0:53:16.22,Default,,0,0,0,,差点害死我们
Dialogue: 0,0:53:16.22,0:53:19.38,Default,,0,0,0,,大便真是舒服啊！
Dialogue: 0,0:53:19.38,0:53:23.91,Default,,0,0,0,,你们相信神就不会彷徨
Dialogue: 0,0:53:23.91,0:53:26.41,Default,,0,0,0,,当然，也要神的引领…
Dialogue: 0,0:53:26.41,0:53:29.72,Default,,0,0,0,,我有个朋友叫格瓦斯基
Dialogue: 0,0:53:29.72,0:53:32.55,Default,,0,0,0,,我们被下放到西伯利亚
Dialogue: 0,0:53:33.23,0:53:36.92,Default,,0,0,0,,搭货运火车到劳改营
Dialogue: 0,0:53:36.92,0:53:40.47,Default,,0,0,0,,沿途冰天雪地，毫无人迹
Dialogue: 0,0:53:40.47,0:53:43.57,Default,,0,0,0,,我们彼此取暖
Dialogue: 0,0:53:43.57,0:53:46.80,Default,,0,0,0,,但是车厢内不能大小号
Dialogue: 0,0:53:46.80,0:53:51.46,Default,,0,0,0,,只有在火车停下加水时
Dialogue: 0,0:53:51.46,0:53:56.96,Default,,0,0,0,,才有机会方便
Dialogue: 0,0:53:56.96,0:54:06.98,Default,,0,0,0,,可是格瓦斯基生性害羞
Dialogue: 0,0:54:06.98,0:54:10.40,Default,,0,0,0,,连一起洗澡都会脸红
Dialogue: 0,0:54:10.40,0:54:14.15,Default,,0,0,0,,我常常取笑他
Dialogue: 0,0:54:14.15,0:54:23.10,Default,,0,0,0,,火车一停，大家赶紧去方便
Dialogue: 0,0:54:23.10,0:54:25.98,Default,,0,0,0,,但是因为我取笑格瓦斯基
Dialogue: 0,0:54:25.98,0:54:30.26,Default,,0,0,0,,所以他跑去较远的地方
Dialogue: 0,0:54:30.26,0:54:34.75,Default,,0,0,0,,火车一开，大家都跳上去
Dialogue: 0,0:54:34.75,0:54:38.51,Default,,0,0,0,,因为火车不等人
Dialogue: 0,0:54:38.51,0:54:41.19,Default,,0,0,0,,可是跑到灌木丛的格瓦斯基
Dialogue: 0,0:54:41.19,0:54:43.76,Default,,0,0,0,,还没有大完
Dialogue: 0,0:54:43.76,0:54:48.25,Default,,0,0,0,,我看到他冲出灌木丛
Dialogue: 0,0:54:48.25,0:54:51.00,Default,,0,0,0,,两手提着裤子
Dialogue: 0,0:54:51.00,0:54:55.14,Default,,0,0,0,,试着追上火车
Dialogue: 0,0:54:55.14,0:54:58.83,Default,,0,0,0,,我向他伸出手
Dialogue: 0,0:54:58.83,0:55:03.56,Default,,0,0,0,,可是每次他一伸出手
Dialogue: 0,0:55:03.56,0:55:05.65,Default,,0,0,0,,裤子就掉到地上
Dialogue: 0,0:55:05.65,0:55:11.88,Default,,0,0,0,,他拉高裤子，再继续跑
Dialogue: 0,0:55:11.88,0:55:17.75,Default,,0,0,0,,但是他一伸手裤子就掉
Dialogue: 0,0:55:18.73,0:55:20.27,Default,,0,0,0,,后来呢？
Dialogue: 0,0:55:20.27,0:55:21.86,Default,,0,0,0,,没什么
Dialogue: 0,0:55:22.25,0:55:26.35,Default,,0,0,0,,格瓦斯基被冷死
Dialogue: 0,0:55:28.55,0:55:32.48,Default,,0,0,0,,再见，再见
Dialogue: 0,0:55:36.52,0:55:38.18,Default,,0,0,0,,他干嘛讲这些？
Dialogue: 0,0:55:46.61,0:55:49.60,Default,,0,0,0,,我记下地址了，再联络
Dialogue: 0,0:55:52.56,0:55:54.18,Default,,0,0,0,,他干嘛讲这些？
Dialogue: 0,0:56:10.30,0:56:15.45,Default,,0,0,0,,各位，我刚出院又两天没吃饭
Dialogue: 0,0:56:15.45,0:56:17.54,Default,,0,0,0,,家里还有小孩
Dialogue: 0,0:56:17.54,0:56:20.18,Default,,0,0,0,,请各位善心人士给些钱
Dialogue: 0,0:56:20.18,0:56:23.25,Default,,0,0,0,,像牛仔用套绳把他逮住
Dialogue: 0,0:56:23.25,0:56:27.00,Default,,0,0,0,,用套绳逮住他
Dialogue: 0,0:56:27.00,0:56:31.11,Default,,0,0,0,,你要干嘛？我爸在坐牢
Dialogue: 0,0:56:31.11,0:56:34.87,Default,,0,0,0,,我妈我哥我姐都在坐牢
Dialogue: 0,0:56:34.87,0:56:36.02,Default,,0,0,0,,去找个工作
Dialogue: 0,0:56:36.02,0:56:38.21,Default,,0,0,0,,干！今天是乞丐总动员吗？
Dialogue: 0,0:56:40.26,0:56:41.66,Default,,0,0,0,,真他妈的！
Dialogue: 0,0:56:43.50,0:56:44.86,Default,,0,0,0,,真他妈的！
Dialogue: 0,0:56:44.86,0:56:50.32,Default,,0,0,0,,各位好，我的房屋津贴被取消
Dialogue: 0,0:56:50.32,0:56:53.80,Default,,0,0,0,,我被赶出来，我希望…
Dialogue: 0,0:56:53.80,0:56:56.34,Default,,0,0,0,,您再走100公尺就到了
Dialogue: 0,0:56:56.34,0:56:57.24,Default,,0,0,0,,谢谢
Dialogue: 0,0:56:57.24,0:56:58.71,Default,,0,0,0,,晚安
Dialogue: 0,0:56:58.71,0:56:59.93,Default,,0,0,0,,谢谢
Dialogue: 0,0:57:04.65,0:57:06.99,Default,,0,0,0,,巴黎的条子真有礼貌
Dialogue: 0,0:57:08.17,0:57:10.33,Default,,0,0,0,,居然用“您”
Dialogue: 0,0:57:21.67,0:57:23.97,Default,,0,0,0,,可能他中了乐透没告诉大家
Dialogue: 0,0:57:28.67,0:57:30.53,Default,,0,0,0,,妈的，是关着的
Dialogue: 0,0:57:32.18,0:57:33.94,Default,,0,0,0,,他的真名是什么？
Dialogue: 0,0:57:34.65,0:57:37.12,Default,,0,0,0,,我只知道他叫亚斯戴
Dialogue: 0,0:57:44.39,0:57:45.44,Default,,0,0,0,,喂
Dialogue: 0,0:57:45.44,0:57:47.35,Default,,0,0,0,,你好，抱歉打扰了
Dialogue: 0,0:57:47.35,0:57:50.20,Default,,0,0,0,,请问亚斯戴住这吗？
Dialogue: 0,0:57:50.20,0:57:54.30,Default,,0,0,0,,我晓得有点怪，可是…
Dialogue: 0,0:57:55.60,0:57:57.57,Default,,0,0,0,,王八蛋，他挂断了
Dialogue: 0,0:57:58.42,0:58:00.09,Default,,0,0,0,,换你来讲
Dialogue: 0,0:58:00.09,0:58:01.10,Default,,0,0,0,,为何是我？
Dialogue: 0,0:58:01.10,0:58:04.46,Default,,0,0,0,,快去啦！我跟黑个儿帮你打气
Dialogue: 0,0:58:06.32,0:58:08.12,Default,,0,0,0,,喂
Dialogue: 0,0:58:08.12,0:58:10.73,Default,,0,0,0,,你好，亚斯戴在吗？
Dialogue: 0,0:58:10.73,0:58:11.81,Default,,0,0,0,,亚斯戴？
Dialogue: 0,0:58:11.81,0:58:14.14,Default,,0,0,0,,我还“黄丝带”呢！
Dialogue: 0,0:58:14.14,0:58:16.58,Default,,0,0,0,,我操你妈的
Dialogue: 0,0:58:16.58,0:58:18.67,Default,,0,0,0,,妈的，全被你搞砸了
Dialogue: 0,0:58:18.67,0:58:20.76,Default,,0,0,0,,别闹了
Dialogue: 0,0:58:20.76,0:58:22.88,Default,,0,0,0,,你好，抱歉打扰了
Dialogue: 0,0:58:22.88,0:58:25.31,Default,,0,0,0,,我有个叫亚斯戴的朋友住这里
Dialogue: 0,0:58:25.31,0:58:28.45,Default,,0,0,0,,可是我不知道他的姓名
Dialogue: 0,0:58:28.45,0:58:30.60,Default,,0,0,0,,你们疯了，这样按铃
Dialogue: 0,0:58:30.60,0:58:32.38,Default,,0,0,0,,真是受不了
Dialogue: 0,0:58:32.38,0:58:34.26,Default,,0,0,0,,算了，我们走
Dialogue: 0,0:58:34.26,0:58:36.10,Default,,0,0,0,,我才不要走！
Dialogue: 0,0:58:36.10,0:58:38.29,Default,,0,0,0,,有本事去叫警察啊！
Dialogue: 0,0:58:38.29,0:58:42.36,Default,,0,0,0,,去叫你香蕉番石榴的警察
Dialogue: 0,0:58:42.36,0:58:43.86,Default,,0,0,0,,扎伊尔？喂
Dialogue: 0,0:58:43.86,0:58:45.95,Default,,0,0,0,,亚斯戴？
Dialogue: 0,0:58:45.95,0:58:49.29,Default,,0,0,0,,扎伊尔？
Dialogue: 0,0:58:49.29,0:58:50.61,Default,,0,0,0,,你住几楼？
Dialogue: 0,0:58:50.61,0:58:51.48,Default,,0,0,0,,5楼
Dialogue: 0,0:58:51.48,0:58:52.97,Default,,0,0,0,,开门
Dialogue: 0,0:58:55.69,0:59:00.75,Default,,0,0,0,,亚斯戴，我从未遭受这种侮辱
Dialogue: 0,0:59:12.60,0:59:13.57,Default,,0,0,0,,有人跟踪吗？
Dialogue: 0,0:59:13.89,0:59:14.76,Default,,0,0,0,,没有
Dialogue: 0,0:59:14.76,0:59:15.28,Default,,0,0,0,,真的没有？
Dialogue: 0,0:59:15.28,0:59:16.01,Default,,0,0,0,,没有
Dialogue: 0,0:59:16.01,0:59:17.06,Default,,0,0,0,,确定？
Dialogue: 0,0:59:17.06,0:59:18.13,Default,,0,0,0,,干嘛？
Dialogue: 0,0:59:18.13,0:59:19.43,Default,,0,0,0,,没干嘛！
Dialogue: 0,0:59:23.49,0:59:24.40,Default,,0,0,0,,你好吗？
Dialogue: 0,0:59:24.40,0:59:25.06,Default,,0,0,0,,你呢？
Dialogue: 0,0:59:25.06,0:59:26.24,Default,,0,0,0,,好极了
Dialogue: 0,0:59:26.24,0:59:27.98,Default,,0,0,0,,他是谁？
Dialogue: 0,0:59:27.98,0:59:30.61,Default,,0,0,0,,这是什么地方？你中了乐透？
Dialogue: 0,0:59:31.32,0:59:33.62,Default,,0,0,0,,这栋租来的公寓我永远不必还
Dialogue: 0,0:59:33.62,0:59:35.36,Default,,0,0,0,,这不是公寓，这是城堡
Dialogue: 0,0:59:35.36,0:59:36.82,Default,,0,0,0,,不敢相信
Dialogue: 0,0:59:36.82,0:59:40.85,Default,,0,0,0,,这是栋豪华公寓
Dialogue: 0,0:59:46.01,0:59:49.00,Default,,0,0,0,,我跟你介绍，他是文兹
Dialogue: 0,0:59:50.04,0:59:50.63,Default,,0,0,0,,你好
Dialogue: 0,0:59:50.63,0:59:53.35,Default,,0,0,0,,雨贝，老雨
Dialogue: 0,0:59:53.35,0:59:54.75,Default,,0,0,0,,我们见过
Dialogue: 0,0:59:55.12,0:59:55.82,Default,,0,0,0,,来点白粉？
Dialogue: 0,0:59:55.82,0:59:56.83,Default,,0,0,0,,不要
Dialogue: 0,0:59:56.83,0:59:57.56,Default,,0,0,0,,确定？
Dialogue: 0,0:59:57.56,0:59:58.36,Default,,0,0,0,,我很确定
Dialogue: 0,0:59:58.36,0:59:59.79,Default,,0,0,0,,来点白粉嘛！
Dialogue: 0,0:59:59.79,1:00:01.25,Default,,0,0,0,,没有人想爽一下？
Dialogue: 0,1:00:01.25,1:00:02.40,Default,,0,0,0,,你哥好吗？
Dialogue: 0,1:00:02.40,1:00:04.31,Default,,0,0,0,,好
Dialogue: 0,1:00:04.31,1:00:06.43,Default,,0,0,0,,那个臭王八小子
Dialogue: 0,1:00:06.43,1:00:07.86,Default,,0,0,0,,他还过得去
Dialogue: 0,1:00:07.86,1:00:08.90,Default,,0,0,0,,他还做爱吗？
Dialogue: 0,1:00:08.90,1:00:09.53,Default,,0,0,0,,你呢？
Dialogue: 0,1:00:09.53,1:00:12.36,Default,,0,0,0,,做到最高点，看
Dialogue: 0,1:00:14.09,1:00:16.98,Default,,0,0,0,,听说我的钱在你手上
Dialogue: 0,1:00:16.98,1:00:19.03,Default,,0,0,0,,我的钱！快点吐出来
Dialogue: 0,1:00:19.03,1:00:23.66,Default,,0,0,0,,别再炫耀了，快给我
Dialogue: 0,1:00:25.88,1:00:27.01,Default,,0,0,0,,过来拿
Dialogue: 0,1:00:27.62,1:00:30.11,Default,,0,0,0,,败类，这可是你说的
Dialogue: 0,1:00:36.43,1:00:37.99,Default,,0,0,0,,不准碰！
Dialogue: 0,1:00:37.99,1:00:39.31,Default,,0,0,0,,干嘛？
Dialogue: 0,1:00:39.31,1:00:41.09,Default,,0,0,0,,这可不是玩具枪
Dialogue: 0,1:00:41.09,1:00:45.22,Default,,0,0,0,,用不着跩，我也有
Dialogue: 0,1:00:45.93,1:00:48.05,Default,,0,0,0,,让我瞧瞧
Dialogue: 0,1:00:48.05,1:00:50.54,Default,,0,0,0,,给我看啊！
Dialogue: 0,1:00:55.08,1:00:57.55,Default,,0,0,0,,扎伊尔，阻止他
Dialogue: 0,1:00:57.55,1:00:58.42,Default,,0,0,0,,妈的！
Dialogue: 0,1:00:58.42,1:01:00.78,Default,,0,0,0,,文兹，快收起来
Dialogue: 0,1:01:00.78,1:01:03.53,Default,,0,0,0,,放心，他识货
Dialogue: 0,1:01:03.53,1:01:06.21,Default,,0,0,0,,它是史密斯威森点44手枪
Dialogue: 0,1:01:06.21,1:01:07.85,Default,,0,0,0,,小心，它已上膛
Dialogue: 0,1:01:07.85,1:01:09.66,Default,,0,0,0,,漂亮！你是个强盗
Dialogue: 0,1:01:09.66,1:01:12.82,Default,,0,0,0,,这是保险
Dialogue: 0,1:01:12.82,1:01:14.18,Default,,0,0,0,,玩过俄罗斯轮盘吗？
Dialogue: 0,1:01:14.18,1:01:14.91,Default,,0,0,0,,什么？
Dialogue: 0,1:01:14.91,1:01:19.78,Default,,0,0,0,,看，装颗子弹，碰！
Dialogue: 0,1:01:20.62,1:01:22.71,Default,,0,0,0,,我没死
Dialogue: 0,1:01:23.75,1:01:24.83,Default,,0,0,0,,你疯了
Dialogue: 0,1:01:24.83,1:01:25.77,Default,,0,0,0,,我没死
Dialogue: 0,1:01:25.77,1:01:27.75,Default,,0,0,0,,是真的子弹
Dialogue: 0,1:01:27.75,1:01:29.63,Default,,0,0,0,,这只是正统玩法
Dialogue: 0,1:01:29.63,1:01:31.06,Default,,0,0,0,,好了
Dialogue: 0,1:01:31.06,1:01:33.67,Default,,0,0,0,,特殊玩法是一次两颗
Dialogue: 0,1:01:33.67,1:01:35.34,Default,,0,0,0,,你在干嘛？
Dialogue: 0,1:01:35.34,1:01:37.39,Default,,0,0,0,,你们怕了？
Dialogue: 0,1:01:37.39,1:01:39.69,Default,,0,0,0,,你是疯了吗？
Dialogue: 0,1:01:39.69,1:01:40.66,Default,,0,0,0,,等等
Dialogue: 0,1:01:40.66,1:01:43.76,Default,,0,0,0,,再玩啊！
Dialogue: 0,1:01:43.76,1:01:44.70,Default,,0,0,0,,换你
Dialogue: 0,1:01:44.70,1:01:47.52,Default,,0,0,0,,好！我们闪，他头壳坏了
Dialogue: 0,1:01:47.52,1:01:48.77,Default,,0,0,0,,你做不做？
Dialogue: 0,1:01:48.77,1:01:49.81,Default,,0,0,0,,好啦
Dialogue: 0,1:01:49.81,1:01:51.59,Default,,0,0,0,,动手啊！
Dialogue: 0,1:01:51.59,1:01:53.54,Default,,0,0,0,,你干嘛？
Dialogue: 0,1:01:53.54,1:01:55.00,Default,,0,0,0,,我做了你却不做？
Dialogue: 0,1:01:55.00,1:01:56.08,Default,,0,0,0,,你到底想怎样？
Dialogue: 0,1:01:56.08,1:01:57.71,Default,,0,0,0,,快动手啊！
Dialogue: 0,1:01:57.71,1:01:59.07,Default,,0,0,0,,别闹了
Dialogue: 0,1:01:59.07,1:02:03.17,Default,,0,0,0,,文兹，住手
Dialogue: 0,1:02:03.17,1:02:04.71,Default,,0,0,0,,你敢用枪指着我？
Dialogue: 0,1:02:04.71,1:02:07.07,Default,,0,0,0,,畜牲！你敢用枪指我？
Dialogue: 0,1:02:07.07,1:02:09.47,Default,,0,0,0,,没错，变态，怎么样？
Dialogue: 0,1:02:09.47,1:02:11.28,Default,,0,0,0,,玩什么鸟烂游戏？
Dialogue: 0,1:02:11.28,1:02:12.95,Default,,0,0,0,,还把我当龟儿子
Dialogue: 0,1:02:12.95,1:02:15.18,Default,,0,0,0,,你想尝尝被枪指着的滋味？
Dialogue: 0,1:02:15.18,1:02:17.27,Default,,0,0,0,,你想见识什么才叫枪？
Dialogue: 0,1:02:17.27,1:02:19.56,Default,,0,0,0,,你在干嘛？
Dialogue: 0,1:02:19.56,1:02:21.72,Default,,0,0,0,,扎伊尔！
Dialogue: 0,1:02:21.72,1:02:25.68,Default,,0,0,0,,快滚
Dialogue: 0,1:02:28.82,1:02:35.95,Default,,0,0,0,,先来点白粉，我再来奸你！
Dialogue: 0,1:02:36.82,1:02:39.95,Default,,0,0,0,,看着
Dialogue: 0,1:02:41.17,1:02:42.88,Default,,0,0,0,,狗娘养的！
Dialogue: 0,1:02:42.88,1:02:45.57,Default,,0,0,0,,他唬人的
Dialogue: 0,1:02:45.97,1:02:47.68,Default,,0,0,0,,我不管，我只知道我拿不到钱
Dialogue: 0,1:02:47.68,1:02:50.08,Default,,0,0,0,,你想胡搞就去，别拖我们下水
Dialogue: 0,1:02:50.08,1:02:52.03,Default,,0,0,0,,我胡搞？
Dialogue: 0,1:02:52.03,1:02:54.43,Default,,0,0,0,,别忘了我们的兄弟还在医院
Dialogue: 0,1:02:54.43,1:02:56.24,Default,,0,0,0,,这两者有关吗？
Dialogue: 0,1:02:56.24,1:02:58.40,Default,,0,0,0,,别老想当烈士，你没这个担当
Dialogue: 0,1:02:58.40,1:03:00.52,Default,,0,0,0,,那你就有担当？
Dialogue: 0,1:03:00.52,1:03:02.99,Default,,0,0,0,,黑人的肩膀比较宽？
Dialogue: 0,1:03:02.99,1:03:04.28,Default,,0,0,0,,干！
Dialogue: 0,1:03:04.28,1:03:06.26,Default,,0,0,0,,来啊！
Dialogue: 0,1:03:06.26,1:03:08.63,Default,,0,0,0,,请过来一下
Dialogue: 0,1:03:08.63,1:03:11.09,Default,,0,0,0,,冷静点
Dialogue: 0,1:03:17.60,1:03:19.10,Default,,0,0,0,,听说你们在吵架？
Dialogue: 0,1:03:19.10,1:03:21.26,Default,,0,0,0,,抓住另一个
Dialogue: 0,1:03:21.26,1:03:23.24,Default,,0,0,0,,轻一点
Dialogue: 0,1:03:23.24,1:03:26.30,Default,,0,0,0,,别动，我们要搜身
Dialogue: 0,1:03:26.30,1:03:28.88,Default,,0,0,0,,你们怎么这么快就到？
Dialogue: 0,1:03:28.88,1:03:35.63,Default,,0,0,0,,在我的地盘你们得一周前预约
Dialogue: 0,1:03:35.63,1:03:36.60,Default,,0,0,0,,年轻人！
Dialogue: 0,1:03:36.60,1:03:39.28,Default,,0,0,0,,你们一道吗？认识他们吗？
Dialogue: 0,1:03:39.28,1:03:40.99,Default,,0,0,0,,不认识
Dialogue: 0,1:03:40.99,1:03:41.96,Default,,0,0,0,,为什么在这里？
Dialogue: 0,1:03:41.96,1:03:43.14,Default,,0,0,0,,我来找我阿姨
Dialogue: 0,1:03:43.14,1:03:45.65,Default,,0,0,0,,你阿姨叫什么？
Dialogue: 0,1:03:45.65,1:03:48.05,Default,,0,0,0,,她姓蔡
Dialogue: 0,1:03:48.05,1:03:49.34,Default,,0,0,0,,蔡什么？出示你的证件
Dialogue: 0,1:03:49.34,1:03:54.14,Default,,0,0,0,,我会的，我是个有为的年轻人
Dialogue: 0,1:03:54.14,1:03:56.64,Default,,0,0,0,,快一点
Dialogue: 0,1:03:56.64,1:03:58.61,Default,,0,0,0,,唉哟，轻一点
Dialogue: 0,1:04:02.07,1:04:03.92,Default,,0,0,0,,你不要动
Dialogue: 0,1:04:03.92,1:04:05.73,Default,,0,0,0,,别动
Dialogue: 0,1:04:05.73,1:04:06.88,Default,,0,0,0,,你认识他吗？
Dialogue: 0,1:04:06.88,1:04:07.85,Default,,0,0,0,,谁？
Dialogue: 0,1:04:07.85,1:04:09.03,Default,,0,0,0,,你的伙伴
Dialogue: 0,1:04:09.03,1:04:09.97,Default,,0,0,0,,不认识
Dialogue: 0,1:04:09.97,1:04:13.52,Default,,0,0,0,,不认识？
Dialogue: 0,1:04:13.52,1:04:16.24,Default,,0,0,0,,想诳我？我们等着瞧
Dialogue: 0,1:04:16.24,1:04:19.40,Default,,0,0,0,,丢脸死了
Dialogue: 0,1:04:19.40,1:04:25.18,Default,,0,0,0,,你早这么想就好了
Dialogue: 0,1:04:25.18,1:04:28.10,Default,,0,0,0,,这是什么？还是好货
Dialogue: 0,1:04:28.10,1:04:30.75,Default,,0,0,0,,我要自己享用
Dialogue: 0,1:04:30.75,1:04:33.39,Default,,0,0,0,,阿富汗的最棒，抽了舒爽无比
Dialogue: 0,1:04:33.39,1:04:39.34,Default,,0,0,0,,黎巴嫩的视地区而定
Dialogue: 0,1:04:39.34,1:04:42.78,Default,,0,0,0,,这个我要留着自己用
Dialogue: 0,1:04:43.62,1:04:47.10,Default,,0,0,0,,那个兔崽子跑了，带回这两个
Dialogue: 0,1:04:47.10,1:04:48.53,Default,,0,0,0,,你坐后面
Dialogue: 0,1:04:48.53,1:04:50.44,Default,,0,0,0,,每次都是我…
Dialogue: 0,1:04:50.44,1:04:52.37,Default,,0,0,0,,坐后面！
Dialogue: 0,1:05:01.78,1:05:05.61,Default,,0,0,0,,你对我而言就像地上的狗屎
Dialogue: 0,1:05:05.61,1:05:08.57,Default,,0,0,0,,知道怎么处理狗屎吗？
Dialogue: 0,1:05:08.57,1:05:11.25,Default,,0,0,0,,用扫把小心除去
Dialogue: 0,1:05:11.25,1:05:15.63,Default,,0,0,0,,或是让它风干，或是把它踩烂
Dialogue: 0,1:05:15.63,1:05:19.40,Default,,0,0,0,,奉劝你，选对大便的地方
Dialogue: 0,1:06:15.48,1:06:19.21,Default,,0,0,0,,这里不是你的地盘
Dialogue: 0,1:06:19.21,1:06:21.99,Default,,0,0,0,,没有兄弟帮你撑腰
Dialogue: 0,1:06:21.99,1:06:24.81,Default,,0,0,0,,用脚捡啊！
Dialogue: 0,1:06:24.81,1:06:28.05,Default,,0,0,0,,在你的国家都是这样
Dialogue: 0,1:06:28.05,1:06:31.25,Default,,0,0,0,,都是用脚捡
Dialogue: 0,1:06:31.25,1:06:35.62,Default,,0,0,0,,这是最辛苦的
Dialogue: 0,1:06:38.10,1:06:39.98,Default,,0,0,0,,不然我们是很轻松的
Dialogue: 0,1:06:39.98,1:06:42.21,Default,,0,0,0,,他们2小时后会被放走
Dialogue: 0,1:06:42.21,1:06:44.19,Default,,0,0,0,,所以要趁机把握
Dialogue: 0,1:06:44.19,1:06:46.69,Default,,0,0,0,,在脖子上开一枪？
Dialogue: 0,1:06:46.69,1:06:48.92,Default,,0,0,0,,只是这样弄一下
Dialogue: 0,1:06:48.92,1:06:51.05,Default,,0,0,0,,要懂得实时住手和自制
Dialogue: 0,1:06:51.05,1:06:52.30,Default,,0,0,0,,这叫做风格
Dialogue: 0,1:06:52.30,1:06:53.90,Default,,0,0,0,,千万要自制
Dialogue: 0,1:06:53.90,1:06:57.83,Default,,0,0,0,,别生气，不会太久的
Dialogue: 0,1:06:57.83,1:07:00.06,Default,,0,0,0,,干！
Dialogue: 0,1:07:00.06,1:07:05.02,Default,,0,0,0,,你说什么？你说什么？
Dialogue: 0,1:07:15.54,1:07:18.19,Default,,0,0,0,,妈的！别碰他
Dialogue: 0,1:07:18.19,1:07:20.34,Default,,0,0,0,,知道这是什么吗？
Dialogue: 0,1:07:20.34,1:07:22.99,Default,,0,0,0,,这是远从上海来的鼻烟壶
Dialogue: 0,1:07:22.99,1:07:25.95,Default,,0,0,0,,我想这位兄弟口渴了
Dialogue: 0,1:07:25.95,1:07:30.26,Default,,0,0,0,,喝吧！
Dialogue: 0,1:07:30.26,1:07:32.70,Default,,0,0,0,,干！
Dialogue: 0,1:07:32.70,1:07:35.48,Default,,0,0,0,,你会伤到自己，别乱动
Dialogue: 0,1:07:35.48,1:07:39.41,Default,,0,0,0,,挣扎只会让我更兴奋
Dialogue: 0,1:07:39.41,1:07:43.00,Default,,0,0,0,,从背后看好像两个马子
Dialogue: 0,1:07:43.00,1:07:46.06,Default,,0,0,0,,两个寄生虫
Dialogue: 0,1:07:46.06,1:07:50.41,Default,,0,0,0,,劣种寄生虫
Dialogue: 0,1:07:50.41,1:07:55.18,Default,,0,0,0,,记得别动肝火，要实时收手
Dialogue: 0,1:07:55.18,1:07:57.68,Default,,0,0,0,,保持冷静是最难的
Dialogue: 0,1:07:57.68,1:08:01.71,Default,,0,0,0,,这样懂了吧！
Dialogue: 0,1:08:05.89,1:08:09.27,Default,,0,0,0,,我比较喜欢他，真可爱
Dialogue: 0,1:08:09.27,1:08:13.41,Default,,0,0,0,,看他证件上的名字
Dialogue: 0,1:08:13.41,1:08:15.11,Default,,0,0,0,,你可爱吗？
Dialogue: 0,1:08:15.11,1:08:17.76,Default,,0,0,0,,可爱！我很可爱
Dialogue: 0,1:08:17.76,1:08:20.37,Default,,0,0,0,,我超级可爱！
Dialogue: 0,1:08:20.37,1:08:25.10,Default,,0,0,0,,雨贝，雨贝是哪一个？
Dialogue: 0,1:08:25.10,1:08:27.92,Default,,0,0,0,,他的长相也配叫雨贝？
Dialogue: 0,1:08:27.92,1:08:30.81,Default,,0,0,0,,他是法国人，另一个叫扎伊尔
Dialogue: 0,1:08:30.81,1:08:32.34,Default,,0,0,0,,名字真好听
Dialogue: 0,1:08:32.34,1:08:35.54,Default,,0,0,0,,扎伊尔也是法国人？
Dialogue: 0,1:08:35.54,1:08:38.01,Default,,0,0,0,,名字真好听
Dialogue: 0,1:08:38.01,1:08:40.20,Default,,0,0,0,,有没有搞错
Dialogue: 0,1:08:40.20,1:08:42.53,Default,,0,0,0,,你看
Dialogue: 0,1:08:42.53,1:08:44.83,Default,,0,0,0,,我就知道他比较带劲
Dialogue: 0,1:08:44.83,1:08:46.95,Default,,0,0,0,,干！放开他
Dialogue: 0,1:08:46.95,1:08:48.66,Default,,0,0,0,,小宝贝还好吧！
Dialogue: 0,1:08:48.66,1:08:51.86,Default,,0,0,0,,最困难的是避免留下伤痕
Dialogue: 0,1:08:51.86,1:08:55.90,Default,,0,0,0,,虽然很想，但也不能为所欲为
Dialogue: 0,1:08:55.90,1:09:01.70,Default,,0,0,0,,海地杂种，你同意吧？
Dialogue: 0,1:09:05.43,1:09:08.16,Default,,0,0,0,,我们走
Dialogue: 0,1:09:29.23,1:09:33.48,Default,,0,0,0,,先生！我们会错过末班火车
Dialogue: 0,1:09:33.48,1:09:35.35,Default,,0,0,0,,他不会让你们走
Dialogue: 0,1:09:35.35,1:09:38.22,Default,,0,0,0,,死人，我有问你吗？
Dialogue: 0,1:10:10.50,1:10:14.66,Default,,0,0,0,,文兹，扎伊尔跟雨贝呢？
Dialogue: 0,1:10:15.13,1:10:17.70,Default,,0,0,0,,别问我，他们烦死了
Dialogue: 0,1:10:17.70,1:10:20.17,Default,,0,0,0,,别一直臭张脸
Dialogue: 0,1:10:50.79,1:10:52.85,Default,,0,0,0,,知道你妹抽大麻吗？
Dialogue: 0,1:10:52.85,1:10:54.71,Default,,0,0,0,,败类！闭嘴
Dialogue: 0,1:10:55.32,1:10:57.47,Default,,0,0,0,,可是她真的抽啊！
Dialogue: 0,1:10:57.47,1:10:59.56,Default,,0,0,0,,你休想打她的主意
Dialogue: 0,1:10:59.56,1:11:03.56,Default,,0,0,0,,门都没有，连看都不行
Dialogue: 0,1:11:03.56,1:11:06.03,Default,,0,0,0,,妈的，快转弯
Dialogue: 0,1:11:06.03,1:11:10.17,Default,,0,0,0,,我不会碰她，听说她有了
Dialogue: 0,1:11:10.17,1:11:12.75,Default,,0,0,0,,你他妈的放屁
Dialogue: 0,1:11:12.75,1:11:15.78,Default,,0,0,0,,不准你侮辱我妹
Dialogue: 0,1:11:15.78,1:11:17.90,Default,,0,0,0,,真是莫名其妙
Dialogue: 0,1:11:38.64,1:11:41.97,Default,,0,0,0,,出去！
Dialogue: 0,1:11:43.54,1:11:46.85,Default,,0,0,0,,每次这个恶霸都不让我们进去
Dialogue: 0,1:11:46.85,1:11:49.98,Default,,0,0,0,,我跟他弟认识10年
Dialogue: 0,1:11:49.98,1:11:53.81,Default,,0,0,0,,他也拒绝我10年
Dialogue: 0,1:11:53.81,1:11:55.28,Default,,0,0,0,,我快气疯了
Dialogue: 0,1:11:56.42,1:11:59.39,Default,,0,0,0,,你拿子弹做什么？
Dialogue: 0,1:11:59.93,1:12:04.46,Default,,0,0,0,,黑鬼，你在干嘛！
Dialogue: 0,1:12:04.46,1:12:07.43,Default,,0,0,0,,别玩牛仔游戏
Dialogue: 0,1:12:07.87,1:12:09.50,Default,,0,0,0,,别闹
Dialogue: 0,1:12:09.50,1:12:12.06,Default,,0,0,0,,王八，没料到我会回来吧！
Dialogue: 0,1:12:12.95,1:12:14.51,Default,,0,0,0,,跩不起来了吧！
Dialogue: 0,1:12:14.51,1:12:16.22,Default,,0,0,0,,去你妈的
Dialogue: 0,1:12:16.22,1:12:19.21,Default,,0,0,0,,我操你和你的烂舞厅
Dialogue: 0,1:12:19.21,1:12:21.79,Default,,0,0,0,,干！死黑鬼
Dialogue: 0,1:12:21.79,1:12:24.05,Default,,0,0,0,,我干！
Dialogue: 0,1:12:38.73,1:12:40.36,Default,,0,0,0,,他们是故意的
Dialogue: 0,1:12:42.21,1:12:43.87,Default,,0,0,0,,死王八条子
Dialogue: 0,1:13:00.37,1:13:01.57,Default,,0,0,0,,下一班是几点？
Dialogue: 0,1:13:02.46,1:13:03.66,Default,,0,0,0,,明天早上
Dialogue: 0,1:13:45.12,1:13:47.04,Default,,0,0,0,,亚斯戴欠你多少？
Dialogue: 0,1:13:47.04,1:13:48.08,Default,,0,0,0,,什么？
Dialogue: 0,1:13:48.08,1:13:49.89,Default,,0,0,0,,亚斯戴欠你多少？
Dialogue: 0,1:13:49.89,1:13:50.95,Default,,0,0,0,,五百
Dialogue: 0,1:13:51.35,1:13:52.40,Default,,0,0,0,,五百万？
Dialogue: 0,1:13:52.40,1:13:53.75,Default,,0,0,0,,五百元
Dialogue: 0,1:13:53.75,1:13:55.14,Default,,0,0,0,,什么？
Dialogue: 0,1:13:55.14,1:13:57.58,Default,,0,0,0,,为了五百元惹得一身腥
Dialogue: 0,1:13:57.58,1:14:00.34,Default,,0,0,0,,不是为钱，是原则问题
Dialogue: 0,1:14:02.07,1:14:03.06,Default,,0,0,0,,原则？
Dialogue: 0,1:14:06.28,1:14:09.17,Default,,0,0,0,,你认为野狼强过哔哔鸟？
Dialogue: 0,1:14:09.17,1:14:11.00,Default,,0,0,0,,布鲁托狗强过大鼻猫？
Dialogue: 0,1:14:11.85,1:14:14.28,Default,,0,0,0,,那金丝雀跟大傻猫谁厉害？
Dialogue: 0,1:14:14.94,1:14:17.07,Default,,0,0,0,,你闪边凉快去
Dialogue: 0,1:14:17.07,1:14:20.30,Default,,0,0,0,,整天梦见母牛的人不配臭屁
Dialogue: 0,1:14:20.30,1:14:23.99,Default,,0,0,0,,其实真正的败类是大力士狗
Dialogue: 0,1:14:23.99,1:14:26.57,Default,,0,0,0,,大力士狗！
Dialogue: 0,1:14:26.57,1:14:29.52,Default,,0,0,0,,谈话到此结束
Dialogue: 0,1:14:29.52,1:14:31.75,Default,,0,0,0,,既然不能沟通就算了
Dialogue: 0,1:14:31.75,1:14:33.18,Default,,0,0,0,,你说这种话？
Dialogue: 0,1:14:33.18,1:14:35.33,Default,,0,0,0,,你们完全搞反了
Dialogue: 0,1:14:35.33,1:14:38.20,Default,,0,0,0,,我认为大鼻子猫强过大力士狗
Dialogue: 0,1:14:38.71,1:14:40.66,Default,,0,0,0,,你胡说什么？
Dialogue: 0,1:14:40.66,1:14:46.03,Default,,0,0,0,,大力士狗大胜大鼻子猫二十次
Dialogue: 0,1:14:46.43,1:14:49.32,Default,,0,0,0,,你说什么？大力士比我强？
Dialogue: 0,1:14:49.32,1:14:50.96,Default,,0,0,0,,大力士是黑人
Dialogue: 0,1:14:50.96,1:14:53.18,Default,,0,0,0,,大力士是黑人？鬼扯！
Dialogue: 0,1:14:53.18,1:14:54.92,Default,,0,0,0,,走吧，反正没事
Dialogue: 0,1:14:54.92,1:14:57.67,Default,,0,0,0,,我们走吧，反正又没事
Dialogue: 0,1:14:57.67,1:14:59.64,Default,,0,0,0,,真是恐怖到极点
Dialogue: 0,1:15:14.69,1:15:19.13,Default,,0,0,0,,雨贝，搞这个的家伙有名吗？
Dialogue: 0,1:15:21.51,1:15:24.07,Default,,0,0,0,,等他18岁就会有名
Dialogue: 0,1:15:41.97,1:15:45.28,Default,,0,0,0,,有香槟，马丁尼，蓝姆酒
Dialogue: 0,1:15:45.28,1:15:46.46,Default,,0,0,0,,我喝不下这么多
Dialogue: 0,1:15:46.46,1:15:47.33,Default,,0,0,0,,不要蓝姆酒
Dialogue: 0,1:15:47.33,1:15:50.63,Default,,0,0,0,,闪啦，我要蓝姆酒和花生
Dialogue: 0,1:15:50.63,1:15:52.97,Default,,0,0,0,,干！
Dialogue: 0,1:15:54.84,1:15:56.31,Default,,0,0,0,,谢谢查理
Dialogue: 0,1:15:56.72,1:15:59.12,Default,,0,0,0,,喂，查理
Dialogue: 0,1:15:59.12,1:16:01.25,Default,,0,0,0,,你看到鬼了吗？
Dialogue: 0,1:16:01.25,1:16:04.17,Default,,0,0,0,,扎伊尔，去跟她们搭讪啊！
Dialogue: 0,1:16:04.17,1:16:09.81,Default,,0,0,0,,妈的，这才是真正的女人
Dialogue: 0,1:16:09.81,1:16:12.90,Default,,0,0,0,,黑皮肤的美呆了
Dialogue: 0,1:16:16.07,1:16:17.91,Default,,0,0,0,,雨贝，帮我一个忙
Dialogue: 0,1:16:17.91,1:16:19.14,Default,,0,0,0,,我不去
Dialogue: 0,1:16:19.55,1:16:21.92,Default,,0,0,0,,我下周带你去希腊
Dialogue: 0,1:16:22.33,1:16:23.48,Default,,0,0,0,,帮我吧！
Dialogue: 0,1:16:23.48,1:16:24.70,Default,,0,0,0,,黑皮肤的！
Dialogue: 0,1:16:24.70,1:16:27.17,Default,,0,0,0,,好
Dialogue: 0,1:16:27.17,1:16:28.60,Default,,0,0,0,,雨贝快去
Dialogue: 0,1:16:28.60,1:16:30.06,Default,,0,0,0,,有两个马子耶！
Dialogue: 0,1:16:30.06,1:16:31.52,Default,,0,0,0,,关我屁事
Dialogue: 0,1:16:31.52,1:16:33.78,Default,,0,0,0,,雨贝，我也要
Dialogue: 0,1:16:33.78,1:16:35.31,Default,,0,0,0,,闭嘴！帮我就好了
Dialogue: 0,1:16:35.31,1:16:38.04,Default,,0,0,0,,雨贝，我也要
Dialogue: 0,1:16:40.32,1:16:43.18,Default,,0,0,0,,我叫雨贝，打扰了
Dialogue: 0,1:16:43.18,1:16:47.28,Default,,0,0,0,,我的好友温柔多情又害羞
Dialogue: 0,1:16:47.28,1:16:52.41,Default,,0,0,0,,他很想和你们交谈，就是那位
Dialogue: 0,1:16:53.55,1:16:55.39,Default,,0,0,0,,请问可以吗？
Dialogue: 0,1:16:55.39,1:16:57.90,Default,,0,0,0,,看你做的好事
Dialogue: 0,1:16:57.90,1:17:00.99,Default,,0,0,0,,他很酷，人非常的好
Dialogue: 0,1:17:00.99,1:17:03.01,Default,,0,0,0,,好吧！
Dialogue: 0,1:17:03.01,1:17:05.86,Default,,0,0,0,,扎伊尔，过来
Dialogue: 0,1:17:05.86,1:17:07.19,Default,,0,0,0,,帮我拿
Dialogue: 0,1:17:08.51,1:17:10.87,Default,,0,0,0,,我们是不是见过？
Dialogue: 0,1:17:10.87,1:17:12.72,Default,,0,0,0,,没有，我很希望是
Dialogue: 0,1:17:12.72,1:17:15.08,Default,,0,0,0,,大家好，我是扎伊尔
Dialogue: 0,1:17:15.75,1:17:16.69,Default,,0,0,0,,你好逊
Dialogue: 0,1:17:16.69,1:17:19.54,Default,,0,0,0,,对不起，你靠在画上
Dialogue: 0,1:17:19.54,1:17:22.11,Default,,0,0,0,,他有说我觉得你很好吗？
Dialogue: 0,1:17:22.11,1:17:23.40,Default,,0,0,0,,那里好？
Dialogue: 0,1:17:23.40,1:17:24.76,Default,,0,0,0,,你说呢？
Dialogue: 0,1:17:24.76,1:17:26.60,Default,,0,0,0,,我以为你很害羞
Dialogue: 0,1:17:26.60,1:17:28.72,Default,,0,0,0,,对啊，我非常害羞
Dialogue: 0,1:17:28.72,1:17:34.26,Default,,0,0,0,,你电话几号？下次邀你看电影
Dialogue: 0,1:17:34.26,1:17:35.79,Default,,0,0,0,,你们男人都一样
Dialogue: 0,1:17:35.79,1:17:38.68,Default,,0,0,0,,你朋友刚才说你想聊天
Dialogue: 0,1:17:38.68,1:17:39.76,Default,,0,0,0,,你要聊天？
Dialogue: 0,1:17:39.76,1:17:41.22,Default,,0,0,0,,聊什么？
Dialogue: 0,1:17:41.22,1:17:47.48,Default,,0,0,0,,你很烦耶！我们很愿意聊一聊
Dialogue: 0,1:17:47.48,1:17:49.78,Default,,0,0,0,,可是你立刻翻脸
Dialogue: 0,1:17:49.78,1:17:51.90,Default,,0,0,0,,要我们如何尊重你？
Dialogue: 0,1:17:51.90,1:17:53.67,Default,,0,0,0,,你当自己是超级模特儿啊？
Dialogue: 0,1:17:53.67,1:17:54.93,Default,,0,0,0,,我又没跟你讲话
Dialogue: 0,1:17:54.93,1:17:56.39,Default,,0,0,0,,我在跟你讲话
Dialogue: 0,1:17:56.39,1:17:58.02,Default,,0,0,0,,他疯了
Dialogue: 0,1:17:58.02,1:18:00.22,Default,,0,0,0,,你看什么？
Dialogue: 0,1:18:00.22,1:18:02.23,Default,,0,0,0,,你是神经病吗？
Dialogue: 0,1:18:02.23,1:18:06.27,Default,,0,0,0,,你才神经！你去哪？
Dialogue: 0,1:18:06.27,1:18:09.09,Default,,0,0,0,,放手，你想干嘛！
Dialogue: 0,1:18:09.09,1:18:11.52,Default,,0,0,0,,我们又没惹你们
Dialogue: 0,1:18:11.52,1:18:15.39,Default,,0,0,0,,请三位冷静一点
Dialogue: 0,1:18:15.39,1:18:17.47,Default,,0,0,0,,老头你别插手
Dialogue: 0,1:18:17.47,1:18:19.46,Default,,0,0,0,,这里有出人命吗？
Dialogue: 0,1:18:19.46,1:18:21.41,Default,,0,0,0,,那就一切没事
Dialogue: 0,1:18:21.41,1:18:23.36,Default,,0,0,0,,请别这样
Dialogue: 0,1:18:23.36,1:18:26.70,Default,,0,0,0,,好了，我们闪人
Dialogue: 0,1:18:26.70,1:18:28.30,Default,,0,0,0,,死老头
Dialogue: 0,1:18:28.30,1:18:30.35,Default,,0,0,0,,别再闹了
Dialogue: 0,1:18:30.35,1:18:31.78,Default,,0,0,0,,你疯了吗？
Dialogue: 0,1:18:31.78,1:18:34.70,Default,,0,0,0,,叫你朋友住手
Dialogue: 0,1:18:34.70,1:18:37.52,Default,,0,0,0,,你算哪根葱？
Dialogue: 0,1:18:37.52,1:18:40.51,Default,,0,0,0,,告诉你们
Dialogue: 0,1:18:40.51,1:18:46.70,Default,,0,0,0,,全部死到地狱去吧！
Dialogue: 0,1:18:46.70,1:18:48.20,Default,,0,0,0,,你们真不酷
Dialogue: 0,1:18:48.20,1:18:50.39,Default,,0,0,0,,妈的，对不起
Dialogue: 0,1:18:50.39,1:18:55.19,Default,,0,0,0,,干你妈的玩得愉快
Dialogue: 0,1:18:58.50,1:18:59.73,Default,,0,0,0,,乡下小混混
Dialogue: 0,1:19:00.07,1:19:02.12,Default,,0,0,0,,应该干走一瓶香槟的
Dialogue: 0,1:19:02.12,1:19:05.32,Default,,0,0,0,,那算什么，我偷了一张信用卡
Dialogue: 0,1:19:05.32,1:19:08.10,Default,,0,0,0,,妈的，你又下海了？
Dialogue: 0,1:19:08.10,1:19:10.89,Default,,0,0,0,,这跟偷脚踏车一样
Dialogue: 0,1:19:10.89,1:19:13.08,Default,,0,0,0,,模戴维先生？
Dialogue: 0,1:19:14.68,1:19:16.91,Default,,0,0,0,,他在不在？不在？
Dialogue: 0,1:19:17.46,1:19:19.17,Default,,0,0,0,,那我收下信用卡
Dialogue: 0,1:19:19.17,1:19:21.16,Default,,0,0,0,,还给我
Dialogue: 0,1:19:21.64,1:19:24.49,Default,,0,0,0,,你胡扯什么？
Dialogue: 0,1:19:24.49,1:19:25.79,Default,,0,0,0,,好屌
Dialogue: 0,1:19:26.23,1:19:27.86,Default,,0,0,0,,你胡扯什么？
Dialogue: 0,1:19:29.26,1:19:30.45,Default,,0,0,0,,你叫戴维？
Dialogue: 0,1:19:30.86,1:19:32.29,Default,,0,0,0,,对啊！
Dialogue: 0,1:19:32.29,1:19:34.41,Default,,0,0,0,,出租车不收信用卡
Dialogue: 0,1:19:34.41,1:19:35.56,Default,,0,0,0,,破例一次嘛！
Dialogue: 0,1:19:35.56,1:19:41.82,Default,,0,0,0,,少来，你故意拿信用卡找碴
Dialogue: 0,1:19:41.82,1:19:43.01,Default,,0,0,0,,你放屁？
Dialogue: 0,1:19:43.53,1:19:45.02,Default,,0,0,0,,是你放的
Dialogue: 0,1:19:45.41,1:19:47.77,Default,,0,0,0,,好臭！不是我，一定是你
Dialogue: 0,1:19:47.77,1:19:48.95,Default,,0,0,0,,不是我的味道
Dialogue: 0,1:19:48.95,1:19:50.76,Default,,0,0,0,,我认得你的屁味
Dialogue: 0,1:19:50.76,1:19:52.89,Default,,0,0,0,,干！他不让我们乘车
Dialogue: 0,1:19:58.87,1:19:59.99,Default,,0,0,0,,谁放屁？
Dialogue: 0,1:19:59.99,1:20:01.06,Default,,0,0,0,,他！
Dialogue: 0,1:20:01.06,1:20:02.25,Default,,0,0,0,,是文兹，是他！
Dialogue: 0,1:20:02.25,1:20:05.51,Default,,0,0,0,,你的屁眼发霉了
Dialogue: 0,1:20:06.28,1:20:08.75,Default,,0,0,0,,我操他妈的死人方向盘
Dialogue: 0,1:20:08.75,1:20:10.65,Default,,0,0,0,,别再哭么
Dialogue: 0,1:20:11.68,1:20:13.83,Default,,0,0,0,,扯掉那玩意
Dialogue: 0,1:20:13.83,1:20:17.73,Default,,0,0,0,,尚克劳德只要5秒就搞定
Dialogue: 0,1:20:17.73,1:20:20.79,Default,,0,0,0,,在邮局上班的尚克劳德？
Dialogue: 0,1:20:20.79,1:20:23.44,Default,,0,0,0,,不，是马子很正典的那个
Dialogue: 0,1:20:23.44,1:20:27.47,Default,,0,0,0,,不对，他因偷车被关2年
Dialogue: 0,1:20:27.47,1:20:29.74,Default,,0,0,0,,快把这玩意搞定
Dialogue: 0,1:20:29.74,1:20:37.91,Default,,0,0,0,,妈的，脚也要踩
Dialogue: 0,1:20:52.70,1:20:55.67,Default,,0,0,0,,警报没了
Dialogue: 0,1:20:57.09,1:21:00.01,Default,,0,0,0,,不要被吓到，我们回去
Dialogue: 0,1:21:00.01,1:21:01.47,Default,,0,0,0,,谁被吓到？
Dialogue: 0,1:21:01.47,1:21:03.35,Default,,0,0,0,,走啦！
Dialogue: 0,1:21:03.35,1:21:05.68,Default,,0,0,0,,小声点
Dialogue: 0,1:21:20.19,1:21:22.89,Default,,0,0,0,,我是汽车终结者
Dialogue: 0,1:21:25.72,1:21:26.78,Default,,0,0,0,,雨刷！
Dialogue: 0,1:21:30.59,1:21:33.27,Default,,0,0,0,,扎伊尔，扯掉塑料盒
Dialogue: 0,1:21:33.27,1:21:34.56,Default,,0,0,0,,快扯掉！
Dialogue: 0,1:21:34.56,1:21:43.09,Default,,0,0,0,,你把绿线和红线接在一起
Dialogue: 0,1:21:43.09,1:21:45.14,Default,,0,0,0,,不对，那是方向灯的线
Dialogue: 0,1:21:45.14,1:21:47.51,Default,,0,0,0,,干！我忘了马盖先是怎么做的
Dialogue: 0,1:21:47.51,1:21:49.27,Default,,0,0,0,,鸡鸡头马盖仙
Dialogue: 0,1:21:52.31,1:21:53.77,Default,,0,0,0,,快要搞定了
Dialogue: 0,1:21:56.73,1:21:58.88,Default,,0,0,0,,妈的！他在这里干嘛？
Dialogue: 0,1:21:58.88,1:22:00.62,Default,,0,0,0,,他是谁？
Dialogue: 0,1:22:00.62,1:22:02.89,Default,,0,0,0,,他吓死我了
Dialogue: 0,1:22:02.89,1:22:05.15,Default,,0,0,0,,你在这里干嘛？
Dialogue: 0,1:22:05.15,1:22:05.81,Default,,0,0,0,,什么？
Dialogue: 0,1:22:05.81,1:22:07.27,Default,,0,0,0,,你在这里干嘛？
Dialogue: 0,1:22:07.27,1:22:08.04,Default,,0,0,0,,没干嘛！
Dialogue: 0,1:22:08.04,1:22:09.85,Default,,0,0,0,,那你滚到一边去
Dialogue: 0,1:22:09.85,1:22:12.66,Default,,0,0,0,,滚！你会害我们被抓
Dialogue: 0,1:22:12.66,1:22:13.71,Default,,0,0,0,,是我老婆
Dialogue: 0,1:22:13.71,1:22:14.96,Default,,0,0,0,,什么你老婆？
Dialogue: 0,1:22:14.96,1:22:18.37,Default,,0,0,0,,我老婆离开我
Dialogue: 0,1:22:18.37,1:22:20.57,Default,,0,0,0,,那关我们屁事？
Dialogue: 0,1:22:21.33,1:22:22.82,Default,,0,0,0,,没事
Dialogue: 0,1:22:23.24,1:22:25.16,Default,,0,0,0,,我们是等着被抓还是要偷车？
Dialogue: 0,1:22:25.16,1:22:26.34,Default,,0,0,0,,快动手
Dialogue: 0,1:22:26.34,1:22:29.40,Default,,0,0,0,,扎伊尔，接上红线和绿线
Dialogue: 0,1:22:29.40,1:22:32.15,Default,,0,0,0,,你别烦我，那是喇叭线
Dialogue: 0,1:22:32.15,1:22:34.10,Default,,0,0,0,,干！那就接蓝线啊！
Dialogue: 0,1:22:34.10,1:22:35.00,Default,,0,0,0,,你来弄
Dialogue: 0,1:22:35.00,1:22:36.74,Default,,0,0,0,,你行你来弄啊！
Dialogue: 0,1:22:36.74,1:22:39.56,Default,,0,0,0,,我要宰了你，照我的话做
Dialogue: 0,1:22:39.56,1:22:43.11,Default,,0,0,0,,不爽就走人
Dialogue: 0,1:22:43.11,1:22:45.06,Default,,0,0,0,,你真的很机车
Dialogue: 0,1:22:45.06,1:22:46.87,Default,,0,0,0,,照你们的话做，喇叭会响
Dialogue: 0,1:22:46.87,1:22:49.34,Default,,0,0,0,,猪头，这才是喇叭线
Dialogue: 0,1:22:49.34,1:22:51.50,Default,,0,0,0,,是扎伊尔说得对
Dialogue: 0,1:22:51.50,1:22:54.45,Default,,0,0,0,,你们看吧！是我说得对
Dialogue: 0,1:22:54.45,1:22:56.82,Default,,0,0,0,,现在照我的话做
Dialogue: 0,1:22:56.82,1:22:58.25,Default,,0,0,0,,是我说得对
Dialogue: 0,1:22:58.25,1:22:59.85,Default,,0,0,0,,动作再快一点
Dialogue: 0,1:22:59.85,1:23:01.69,Default,,0,0,0,,小猴崽你冷静点
Dialogue: 0,1:23:01.69,1:23:03.43,Default,,0,0,0,,你是个好人，叫什么名字？
Dialogue: 0,1:23:03.43,1:23:05.14,Default,,0,0,0,,我叫…
Dialogue: 0,1:23:05.14,1:23:06.35,Default,,0,0,0,,你叫什么名字？
Dialogue: 0,1:23:06.35,1:23:07.09,Default,,0,0,0,,我叫…
Dialogue: 0,1:23:07.09,1:23:09.63,Default,,0,0,0,,别跟他讲话
Dialogue: 0,1:23:09.63,1:23:11.78,Default,,0,0,0,,至少他还派上用场
Dialogue: 0,1:23:11.78,1:23:14.46,Default,,0,0,0,,准备要看了喔！
Dialogue: 0,1:23:14.46,1:23:17.45,Default,,0,0,0,,好
Dialogue: 0,1:23:24.94,1:23:29.08,Default,,0,0,0,,谁会开车？
Dialogue: 0,1:23:29.08,1:23:31.02,Default,,0,0,0,,谁会开车？
Dialogue: 0,1:23:31.02,1:23:31.93,Default,,0,0,0,,文兹
Dialogue: 0,1:23:31.93,1:23:33.04,Default,,0,0,0,,为什么是我？
Dialogue: 0,1:23:33.04,1:23:36.38,Default,,0,0,0,,我…我没当过兵也没驾照
Dialogue: 0,1:23:36.38,1:23:39.34,Default,,0,0,0,,雨贝有驾照，你当过兵吧？
Dialogue: 0,1:23:39.34,1:23:42.09,Default,,0,0,0,,我是海军，没有驾照
Dialogue: 0,1:23:42.09,1:23:43.38,Default,,0,0,0,,我会开车
Dialogue: 0,1:23:43.38,1:23:46.65,Default,,0,0,0,,闭嘴！
Dialogue: 0,1:23:46.65,1:23:47.41,Default,,0,0,0,,文兹
Dialogue: 0,1:23:47.41,1:23:47.90,Default,,0,0,0,,干嘛？
Dialogue: 0,1:23:47.90,1:23:50.37,Default,,0,0,0,,你告诉我跟个马子开奔驰去玩
Dialogue: 0,1:23:50.37,1:23:53.19,Default,,0,0,0,,你骗我
Dialogue: 0,1:23:53.19,1:23:54.58,Default,,0,0,0,,呃…那不一样
Dialogue: 0,1:23:54.58,1:23:59.18,Default,,0,0,0,,因为奔驰车是自排，不一样的
Dialogue: 0,1:23:59.18,1:24:00.32,Default,,0,0,0,,你做梦
Dialogue: 0,1:24:00.32,1:24:02.06,Default,,0,0,0,,你他妈的才做梦
Dialogue: 0,1:24:02.06,1:24:10.24,Default,,0,0,0,,你们分明是草包又爱装模做样
Dialogue: 0,1:24:10.24,1:24:12.78,Default,,0,0,0,,妈的，干嘛？
Dialogue: 0,1:24:12.78,1:24:16.36,Default,,0,0,0,,我不想打扰你们，可是有警车
Dialogue: 0,1:24:16.36,1:24:17.17,Default,,0,0,0,,那里？
Dialogue: 0,1:24:17.17,1:24:20.61,Default,,0,0,0,,那是警车，它来了
Dialogue: 0,1:24:20.61,1:24:26.21,Default,,0,0,0,,别慌，数到三就闪，好了吗？
Dialogue: 0,1:24:26.21,1:24:30.77,Default,,0,0,0,,三
Dialogue: 0,1:24:34.29,1:24:36.34,Default,,0,0,0,,站住
Dialogue: 0,1:24:36.34,1:24:41.54,Default,,0,0,0,,你别挡路
Dialogue: 0,1:24:47.93,1:24:50.36,Default,,0,0,0,,你用O.C.B.牌卷烟纸？
Dialogue: 0,1:24:50.36,1:24:51.58,Default,,0,0,0,,你知道的啊
Dialogue: 0,1:24:51.58,1:24:53.28,Default,,0,0,0,,你用O.C.B.牌卷烟纸？
Dialogue: 0,1:24:53.28,1:24:55.34,Default,,0,0,0,,你知道的啊
Dialogue: 0,1:24:55.34,1:24:57.33,Default,,0,0,0,,知道个鬼！
Dialogue: 0,1:24:58.50,1:25:02.02,Default,,0,0,0,,有时我们真不来电
Dialogue: 0,1:25:02.02,1:25:04.45,Default,,0,0,0,,你还有其它名言要说吗？
Dialogue: 0,1:25:04.45,1:25:07.34,Default,,0,0,0,,有！“小小鸟儿要筑巢”
Dialogue: 0,1:25:07.34,1:25:09.81,Default,,0,0,0,,“各司其职，天下太平”
Dialogue: 0,1:25:09.81,1:25:12.74,Default,,0,0,0,,“早起的鸟儿有虫吃”
Dialogue: 0,1:25:12.74,1:25:15.59,Default,,0,0,0,,“自由，平等，博爱”
Dialogue: 0,1:25:15.59,1:25:18.18,Default,,0,0,0,,这句我留在特殊场合才使用
Dialogue: 0,1:25:19.24,1:25:21.84,Default,,0,0,0,,真是有够他妈的
Dialogue: 0,1:25:22.83,1:25:24.49,Default,,0,0,0,,我头痛死了
Dialogue: 0,1:25:24.98,1:25:26.71,Default,,0,0,0,,你的大麻真香
Dialogue: 0,1:25:28.74,1:25:31.11,Default,,0,0,0,,扎伊尔，别胡来
Dialogue: 0,1:25:31.11,1:25:32.88,Default,,0,0,0,,哇！有喷漆
Dialogue: 0,1:25:32.88,1:25:33.61,Default,,0,0,0,,别管他
Dialogue: 0,1:25:33.61,1:25:34.55,Default,,0,0,0,,有喷漆
Dialogue: 0,1:25:34.55,1:25:35.46,Default,,0,0,0,,你有够机车
Dialogue: 0,1:25:35.46,1:25:36.99,Default,,0,0,0,,还可以用
Dialogue: 0,1:25:36.99,1:25:39.15,Default,,0,0,0,,刚才厕所的老头想说什么？
Dialogue: 0,1:25:39.15,1:25:42.83,Default,,0,0,0,,他提到神跟便便，到底啥意思
Dialogue: 0,1:25:42.83,1:25:44.40,Default,,0,0,0,,我看到极右派
Dialogue: 0,1:25:44.40,1:25:45.58,Default,,0,0,0,,你才是极右派
Dialogue: 0,1:25:45.58,1:25:47.08,Default,,0,0,0,,极右派去死
Dialogue: 0,1:25:47.08,1:25:51.25,Default,,0,0,0,,我懂了！神要人们大便
Dialogue: 0,1:25:51.25,1:25:53.42,Default,,0,0,0,,所以是祂制造出便便
Dialogue: 0,1:25:53.90,1:25:54.98,Default,,0,0,0,,你根本不懂哲学
Dialogue: 0,1:25:54.98,1:25:58.25,Default,,0,0,0,,换我抽大麻！来听我吟诗
Dialogue: 0,1:25:58.25,1:26:04.02,Default,,0,0,0,,“极右派老大的鸡鸡死翘翘”
Dialogue: 0,1:26:05.07,1:26:06.93,Default,,0,0,0,,怎样？酷毙吧！
Dialogue: 0,1:26:07.54,1:26:09.27,Default,,0,0,0,,滚啦！
Dialogue: 0,1:26:17.94,1:26:18.74,Default,,0,0,0,,文兹
Dialogue: 0,1:26:19.41,1:26:21.11,Default,,0,0,0,,听过某人
Dialogue: 0,1:26:21.11,1:26:23.14,Default,,0,0,0,,从五十楼掉下的故事吗？
Dialogue: 0,1:26:23.76,1:26:26.96,Default,,0,0,0,,在坠落过程他一直想
Dialogue: 0,1:26:26.96,1:26:30.59,Default,,0,0,0,,“目前为止还好”
Dialogue: 0,1:26:34.09,1:26:39.14,Default,,0,0,0,,我听过，主角换成犹太教教士
Dialogue: 0,1:26:39.14,1:26:41.78,Default,,0,0,0,,“目前为止还好”是我们的写照
Dialogue: 0,1:26:41.78,1:26:44.67,Default,,0,0,0,,但坠落过程并不重要
Dialogue: 0,1:26:44.67,1:26:46.02,Default,,0,0,0,,而是落地的剎那
Dialogue: 0,1:26:46.02,1:26:49.76,Default,,0,0,0,,我像是迷失在外层空间的蚂蚁
Dialogue: 0,1:26:50.69,1:26:53.42,Default,,0,0,0,,看我熄灭艾菲尔铁塔
Dialogue: 0,1:26:59.32,1:27:01.54,Default,,0,0,0,,闭嘴！又不是演电影
Dialogue: 0,1:27:01.54,1:27:03.49,Default,,0,0,0,,操你妈的
Dialogue: 0,1:27:03.49,1:27:04.68,Default,,0,0,0,,你相信电影吗？
Dialogue: 0,1:27:04.68,1:27:07.25,Default,,0,0,0,,对，如果是演你妈喝尿
Dialogue: 0,1:27:07.25,1:27:08.68,Default,,0,0,0,,干嘛侮辱我妈？
Dialogue: 0,1:27:08.68,1:27:12.05,Default,,0,0,0,,我妈喝尿，那你妈吃屎
Dialogue: 0,1:27:12.05,1:27:14.94,Default,,0,0,0,,你爸妈住在猪圈里
Dialogue: 0,1:27:14.94,1:27:20.90,Default,,0,0,0,,你好贱，这样侮辱我爸
Dialogue: 0,1:27:25.07,1:27:28.63,Default,,0,0,0,,“世界属于你们”
Dialogue: 0,1:27:39.85,1:27:42.12,Default,,0,0,0,,世界属于“我”们
Dialogue: 0,1:27:49.84,1:27:52.70,Default,,0,0,0,,去别的地方胡搞
Dialogue: 0,1:27:52.70,1:27:54.43,Default,,0,0,0,,去外层空间吗？
Dialogue: 0,1:27:54.43,1:27:59.03,Default,,0,0,0,,你好烦
Dialogue: 0,1:28:06.68,1:28:09.95,Default,,0,0,0,,他们如何把车子开进拳击馆？
Dialogue: 0,1:28:09.95,1:28:11.48,Default,,0,0,0,,去问柯受良
Dialogue: 0,1:28:11.48,1:28:13.64,Default,,0,0,0,,真好笑
Dialogue: 0,1:28:13.64,1:28:17.40,Default,,0,0,0,,看看这群遵守社会规则的庸才
Dialogue: 0,1:28:17.40,1:28:19.66,Default,,0,0,0,,看那位穿着体面的仁兄
Dialogue: 0,1:28:19.66,1:28:21.26,Default,,0,0,0,,是最惨的一群
Dialogue: 0,1:28:21.26,1:28:23.49,Default,,0,0,0,,这群遵循社会体制
Dialogue: 0,1:28:23.49,1:28:24.57,Default,,0,0,0,,用劳力辛勤工作的人
Dialogue: 0,1:28:24.57,1:28:26.03,Default,,0,0,0,,投票给极右派，但也是他们
Dialogue: 0,1:28:26.03,1:28:29.19,Default,,0,0,0,,为了电梯故障而示威游行
Dialogue: 0,1:29:12.34,1:29:15.21,Default,,0,0,0,,“种族歧视”
Dialogue: 0,1:29:23.48,1:29:26.45,Default,,0,0,0,,塞拉耶弗内战
Dialogue: 0,1:29:39.66,1:29:42.53,Default,,0,0,0,,“阿布德逝世”
Dialogue: 0,1:29:48.78,1:29:49.77,Default,,0,0,0,,文兹呢？
Dialogue: 0,1:29:52.12,1:29:53.31,Default,,0,0,0,,文兹！
Dialogue: 0,1:29:58.45,1:29:59.78,Default,,0,0,0,,我干！
Dialogue: 0,1:30:19.43,1:30:20.63,Default,,0,0,0,,干嘛？
Dialogue: 0,1:30:22.60,1:30:24.06,Default,,0,0,0,,你是一个大麻烦
Dialogue: 0,1:30:24.06,1:30:27.30,Default,,0,0,0,,我做了什么？
Dialogue: 0,1:30:27.30,1:30:32.93,Default,,0,0,0,,你别诬赖我，我做了什么？
Dialogue: 0,1:30:32.93,1:30:36.06,Default,,0,0,0,,我做了什么？
Dialogue: 0,1:30:36.06,1:30:39.02,Default,,0,0,0,,这白痴是怎么了？
Dialogue: 0,1:30:39.02,1:30:41.25,Default,,0,0,0,,你烦死我了
Dialogue: 0,1:30:41.25,1:30:42.99,Default,,0,0,0,,我做了什么？
Dialogue: 0,1:30:42.99,1:30:45.32,Default,,0,0,0,,扎伊尔，你帮帮我吧！
Dialogue: 0,1:30:45.32,1:30:47.58,Default,,0,0,0,,我是做了什么？
Dialogue: 0,1:30:47.58,1:30:50.19,Default,,0,0,0,,他干嘛跩了起来
Dialogue: 0,1:30:50.19,1:30:51.72,Default,,0,0,0,,他受够了你的蠢事
Dialogue: 0,1:30:51.72,1:30:53.32,Default,,0,0,0,,我做了什么蠢事？
Dialogue: 0,1:30:53.32,1:30:55.19,Default,,0,0,0,,我有做蠢事吗？
Dialogue: 0,1:30:56.00,1:30:59.06,Default,,0,0,0,,如果你想宰条子就去吧！
Dialogue: 0,1:30:59.06,1:31:04.53,Default,,0,0,0,,要去自己去，我们不陪你
Dialogue: 0,1:31:05.50,1:31:07.37,Default,,0,0,0,,我们走了
Dialogue: 0,1:31:08.95,1:31:12.25,Default,,0,0,0,,你们两个快滚
Dialogue: 0,1:31:14.06,1:31:16.43,Default,,0,0,0,,我不需要你们
Dialogue: 0,1:31:20.36,1:31:22.83,Default,,0,0,0,,我的头脑清醒得很
Dialogue: 0,1:31:23.42,1:31:25.58,Default,,0,0,0,,闭上你的狗嘴
Dialogue: 0,1:31:26.10,1:31:27.90,Default,,0,0,0,,我操你娘的
Dialogue: 0,1:31:37.86,1:31:39.62,Default,,0,0,0,,妈的
Dialogue: 0,1:31:45.20,1:31:47.01,Default,,0,0,0,,扎伊尔，别管闲事
Dialogue: 0,1:31:47.01,1:31:48.62,Default,,0,0,0,,难道要见死不救？
Dialogue: 0,1:31:48.62,1:31:49.58,Default,,0,0,0,,真受不了你们
Dialogue: 0,1:31:56.55,1:31:59.82,Default,,0,0,0,,刚才是他在屋顶上侮辱我们
Dialogue: 0,1:31:59.82,1:32:03.09,Default,,0,0,0,,刚才他在屋顶上？
Dialogue: 0,1:32:03.09,1:32:06.75,Default,,0,0,0,,过来跟我们打啊！
Dialogue: 0,1:32:14.82,1:32:16.48,Default,,0,0,0,,你们回来！
Dialogue: 0,1:32:18.47,1:32:20.14,Default,,0,0,0,,兔崽子再屌啊！
Dialogue: 0,1:32:20.14,1:32:21.32,Default,,0,0,0,,我什么也没做
Dialogue: 0,1:32:21.32,1:32:22.82,Default,,0,0,0,,你跑得比子弹快吗？
Dialogue: 0,1:32:22.82,1:32:25.76,Default,,0,0,0,,我什么也没做
Dialogue: 0,1:32:26.68,1:32:31.71,Default,,0,0,0,,干！敢打我
Dialogue: 0,1:32:38.65,1:32:41.12,Default,,0,0,0,,怎么处置他？
Dialogue: 0,1:32:41.12,1:32:44.52,Default,,0,0,0,,狗娘养的
Dialogue: 0,1:32:46.90,1:32:51.74,Default,,0,0,0,,你要怎么处置他？
Dialogue: 0,1:32:51.74,1:32:55.28,Default,,0,0,0,,我要怎么处置他？
Dialogue: 0,1:32:55.28,1:32:58.59,Default,,0,0,0,,你以为我只是说说而已
Dialogue: 0,1:32:58.59,1:33:01.27,Default,,0,0,0,,你也以为我只是说说而已
Dialogue: 0,1:33:01.27,1:33:05.20,Default,,0,0,0,,有种就别拦我
Dialogue: 0,1:33:05.20,1:33:06.87,Default,,0,0,0,,文兹！
Dialogue: 0,1:33:06.87,1:33:08.84,Default,,0,0,0,,别拦他
Dialogue: 0,1:33:09.59,1:33:11.55,Default,,0,0,0,,你要伸张人权？
Dialogue: 0,1:33:11.99,1:33:13.73,Default,,0,0,0,,闭嘴
Dialogue: 0,1:33:13.73,1:33:15.47,Default,,0,0,0,,警察也有好的
Dialogue: 0,1:33:15.47,1:33:19.02,Default,,0,0,0,,但是好的极右派是烂货
Dialogue: 0,1:33:19.02,1:33:20.69,Default,,0,0,0,,开枪啊！
Dialogue: 0,1:33:20.69,1:33:24.31,Default,,0,0,0,,你为了这个烦我们一整天
Dialogue: 0,1:33:24.31,1:33:26.50,Default,,0,0,0,,反正枪是你的
Dialogue: 0,1:33:26.50,1:33:29.00,Default,,0,0,0,,住手
Dialogue: 0,1:33:29.00,1:33:32.67,Default,,0,0,0,,开枪
Dialogue: 0,1:33:33.39,1:33:36.48,Default,,0,0,0,,妈的，动手啊！
Dialogue: 0,1:33:38.33,1:33:41.18,Default,,0,0,0,,开枪干死他
Dialogue: 0,1:33:41.18,1:33:48.52,Default,,0,0,0,,阿布德死了，你可以报仇了
Dialogue: 0,1:33:48.52,1:33:51.22,Default,,0,0,0,,开枪报仇啊！
Dialogue: 0,1:33:54.58,1:33:56.34,Default,,0,0,0,,打死他！
Dialogue: 0,1:34:06.41,1:34:08.34,Default,,0,0,0,,快滚
Dialogue: 0,1:34:37.03,1:34:39.33,Default,,0,0,0,,文兹，明天见
Dialogue: 0,1:34:51.61,1:34:52.84,Default,,0,0,0,,你拿去
Dialogue: 0,1:34:57.21,1:34:59.06,Default,,0,0,0,,我们亲一下，唱首歌？
Dialogue: 0,1:34:59.06,1:35:00.97,Default,,0,0,0,,你好烦，去睡吧！
Dialogue: 0,1:35:00.97,1:35:03.17,Default,,0,0,0,,文兹，我们走
Dialogue: 0,1:35:03.75,1:35:05.24,Default,,0,0,0,,雨贝，明天见
Dialogue: 0,1:35:06.15,1:35:07.89,Default,,0,0,0,,你听过修女的笑话？
Dialogue: 0,1:35:07.89,1:35:08.45,Default,,0,0,0,,没有
Dialogue: 0,1:35:08.45,1:35:10.89,Default,,0,0,0,,有个醉汉走出酒吧
Dialogue: 0,1:35:10.89,1:35:12.90,Default,,0,0,0,,看到对街上有位修女
Dialogue: 0,1:35:12.90,1:35:16.63,Default,,0,0,0,,你知道修女穿着黑色长披风
Dialogue: 0,1:35:16.63,1:35:22.57,Default,,0,0,0,,然后他用花生塞修女牙缝
Dialogue: 0,1:35:23.66,1:35:25.05,Default,,0,0,0,,5分钟后…
Dialogue: 0,1:35:25.05,1:35:26.89,Default,,0,0,0,,等他狠狠整完修女
Dialogue: 0,1:35:26.89,1:35:27.87,Default,,0,0,0,,看着修女，说
Dialogue: 0,1:35:27.87,1:35:30.13,Default,,0,0,0,,“蝙蝠侠，我还以为你很厉害”
Dialogue: 0,1:35:30.13,1:35:34.79,Default,,0,0,0,,够屌吧？修女穿蝙蝠侠的披风
Dialogue: 0,1:35:34.79,1:35:37.92,Default,,0,0,0,,我听过，主角换成犹太教教士
Dialogue: 0,1:35:38.72,1:35:40.78,Default,,0,0,0,,你们过来
Dialogue: 0,1:35:41.23,1:35:43.56,Default,,0,0,0,,妈的，怎么回事？
Dialogue: 0,1:35:43.56,1:35:45.58,Default,,0,0,0,,我认得你
Dialogue: 0,1:35:45.58,1:35:47.56,Default,,0,0,0,,清晨你在屋顶上
Dialogue: 0,1:35:47.56,1:35:49.89,Default,,0,0,0,,王八，你在屋顶上
Dialogue: 0,1:35:49.89,1:35:52.61,Default,,0,0,0,,你做什么？
Dialogue: 0,1:35:52.61,1:35:54.56,Default,,0,0,0,,住手
Dialogue: 0,1:35:54.56,1:35:58.66,Default,,0,0,0,,畜牲，你有意见？
Dialogue: 0,1:35:58.66,1:36:03.85,Default,,0,0,0,,现在跩不起来了？
Dialogue: 0,1:36:03.85,1:36:05.93,Default,,0,0,0,,你干嘛？
Dialogue: 0,1:36:05.93,1:36:10.84,Default,,0,0,0,,看清楚
Dialogue: 0,1:36:38.75,1:36:41.50,Default,,0,0,0,,这是社会坠落的故事
Dialogue: 0,1:36:41.50,1:36:44.96,Default,,0,0,0,,坠落时重复一句话安慰自己
Dialogue: 0,1:36:45.53,1:36:47.30,Default,,0,0,0,,“目前为止还好”
Dialogue: 0,1:36:54.51,1:36:58.23,Default,,0,0,0,,然而坠落过程并不重要
Dialogue: 0,1:36:58.23,1:37:00.83,Default,,0,0,0,,而是落地的剎那
Dialogue: 0,1:37:02.55,1:37:07.42,Default,,0,0,0,,谢谢观赏

